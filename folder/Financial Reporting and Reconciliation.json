    {
      "parameters": {
        "sendTo": "={{ $env.EXECUTIVE_TEAM_EMAIL }}",
        "subject": "=Monthly Financial Report - {{ $json.period }}",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto;\">\n<h1>Monthly Financial Report</h1>\n<p><strong>Period:</strong> {{ $json.period }}</p>\n\n<h2>Executive Summary</h2>\n<p>{{ $json.analysis.executive_summary }}</p>\n\n<h2>Key Metrics</h2>\n<table style=\"width: 100%; border-collapse: collapse; margin: 20px 0;\">\n<tr style=\"background: #f5f5f5;\">\n<td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Revenue</strong></td>\n<td style=\"padding: 10px; border: 1px solid #ddd; text-align: right;\">${{ $json.income_statement.revenue?.toLocaleString() }}</td>\n<td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Gross Margin</strong></td>\n<td style=\"padding: 10px; border: 1px solid #ddd; text-align: right;\">{{ $json.metrics.gross_margin?.toFixed(1) }}%</td>\n</tr>\n<tr>\n<td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Net Income</strong></td>\n<td style=\"padding: 10px; border: 1px solid #ddd; text-align: right;\">${{ $json.income_statement.net_income?.toLocaleString() }}</td>\n<td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Net Margin</strong></td>\n<td style=\"padding: 10px; border: 1px solid #ddd; text-align: right;\">{{ $json.metrics.net_margin?.toFixed(1) }}%</td>\n</tr>\n<tr style=\"background: #f5f5f5;\">\n<td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Current Ratio</strong></td>\n<td style=\"padding: 10px; border: 1px solid #ddd; text-align: right;\">{{ $json.metrics.current_ratio?.toFixed(2) }}</td>\n<td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>DSO</strong></td>\n<td style=\"padding: 10px; border: 1px solid #ddd; text-align: right;\">{{ $json.metrics.dso?.toFixed(0) }} days</td>\n</tr>\n</table>\n\n<h2>Key Highlights</h2>\n<ul>\n{{ $json.analysis.highlights?.map(h => `<li>${h}</li>`).join('') || '<li>Analysis pending</li>' }}\n</ul>\n\n{{ $json.analysis.concerns?.length > 0 ? `<h2 style=\"color: #d32f2f;\">Areas of Concern</h2><ul>${$json.analysis.concerns.map(c => '<li>' + c + '</li>').join('')}</ul>` : '' }}\n\n<h2>Recommendations</h2>\n<ul>\n{{ $json.analysis.recommendations?.map(r => `<li>${r}</li>`).join('') || '<li>No specific recommendations</li>' }}\n</ul>\n\n<p style=\"margin-top: 30px;\"><a href=\"{{ $json.box_url }}\" style=\"background: #1976d2; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px;\">Download Full Report (PDF)</a></p>\n</div>",
        "options": {}
      },

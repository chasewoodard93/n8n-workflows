    {
      "parameters": {
        "sendTo": "={{ $env.ACCOUNTING_TEAM_EMAIL }}",
        "subject": "=⚠️ Bank Reconciliation Discrepancies - {{ $json.date }}",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<h2 style=\"color: #ff9800;\">Bank Reconciliation Alert</h2>\n<p>Discrepancies found in the daily bank reconciliation for {{ $json.date }}.</p>\n\n<div style=\"background: #fff3e0; padding: 15px; border-radius: 4px; margin: 20px 0;\">\n<p><strong>Bank Balance:</strong> ${{ $json.bank_balance?.toLocaleString() }}</p>\n<p><strong>Book Balance:</strong> ${{ $json.book_balance?.toLocaleString() }}</p>\n<p><strong>Difference:</strong> ${{ $json.summary.balance_difference?.toLocaleString() }}</p>\n</div>\n\n<h3>Unmatched Transactions</h3>\n\n{{ $json.bank_only.length > 0 ? `<h4>In Bank Only (${$json.bank_only.length})</h4><ul>${$json.bank_only.slice(0,10).map(t => '<li>' + t.description + ': $' + t.amount + '</li>').join('')}</ul>` : '' }}\n\n{{ $json.book_only.length > 0 ? `<h4>In Books Only (${$json.book_only.length})</h4><ul>${$json.book_only.slice(0,10).map(t => '<li>' + t.description + ': $' + t.amount + '</li>').join('')}</ul>` : '' }}\n\n<p style=\"margin: 20px 0;\"><a href=\"{{ $env.RECONCILIATION_PORTAL_URL }}/review/{{ $json.date }}\" style=\"background: #ff9800; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px;\">Review Discrepancies</a></p>\n</div>",
        "options": {}
      },
      "id": "email-discrepancies",
      "name": "Email Discrepancy Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1800, 920],
      "credentials": {
        "smtp": {
          "id": "smtp-creds",
          "name": "SMTP"
        }
      }
    },

    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Combine all financial data\nconst incomeStatement = items[0]?.json || {};\nconst balanceSheet = items[1]?.json || {};\nconst cashFlow = items[2]?.json || {};\nconst arAging = items[3]?.json || {};\n\n// Calculate key metrics\nconst metrics = {\n  // Profitability\n  gross_margin: incomeStatement.gross_profit / incomeStatement.revenue * 100,\n  net_margin: incomeStatement.net_income / incomeStatement.revenue * 100,\n  operating_margin: incomeStatement.operating_income / incomeStatement.revenue * 100,\n  \n  // Liquidity\n  current_ratio: balanceSheet.current_assets / balanceSheet.current_liabilities,\n  quick_ratio: (balanceSheet.current_assets - balanceSheet.inventory) / balanceSheet.current_liabilities,\n  \n  // Efficiency\n  dso: arAging.total_ar / (incomeStatement.revenue / 30), // Days Sales Outstanding\n  \n  // Cash\n  operating_cash_flow: cashFlow.operating_cash_flow,\n  free_cash_flow: cashFlow.operating_cash_flow - cashFlow.capital_expenditures,\n  \n  // Growth (vs prior period)\n  revenue_growth: incomeStatement.revenue_growth_pct,\n  expense_growth: incomeStatement.expense_growth_pct\n};\n\nreturn [{\n  json: {\n    period: items[0]?.json?.period,\n    income_statement: incomeStatement,\n    balance_sheet: balanceSheet,\n    cash_flow: cashFlow,\n    ar_aging: arAging,\n    metrics: metrics,\n    generated_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "calculate-metrics",
      "name": "Calculate Financial Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, 400]

    {
      "parameters": {
        "promptType": "define",
        "text": "Analyze this monthly financial report and provide executive insights:\n\nPeriod: {{ $json.period }}\n\nIncome Statement Summary:\n- Revenue: ${{ $json.income_statement.revenue?.toLocaleString() }}\n- Gross Profit: ${{ $json.income_statement.gross_profit?.toLocaleString() }}\n- Operating Income: ${{ $json.income_statement.operating_income?.toLocaleString() }}\n- Net Income: ${{ $json.income_statement.net_income?.toLocaleString() }}\n\nKey Metrics:\n- Gross Margin: {{ $json.metrics.gross_margin?.toFixed(1) }}%\n- Net Margin: {{ $json.metrics.net_margin?.toFixed(1) }}%\n- Current Ratio: {{ $json.metrics.current_ratio?.toFixed(2) }}\n- Days Sales Outstanding: {{ $json.metrics.dso?.toFixed(0) }} days\n- Free Cash Flow: ${{ $json.metrics.free_cash_flow?.toLocaleString() }}\n\nAR Aging:\n- Current: ${{ $json.ar_aging.current?.toLocaleString() }}\n- 30 Days: ${{ $json.ar_aging.days_30?.toLocaleString() }}\n- 60 Days: ${{ $json.ar_aging.days_60?.toLocaleString() }}\n- 90+ Days: ${{ $json.ar_aging.days_90_plus?.toLocaleString() }}\n\nProvide:\n1. Executive Summary (3-4 sentences)\n2. Key Highlights (3-5 bullet points)\n3. Areas of Concern (if any)\n4. Recommendations (2-3 actionable items)\n5. Month-over-Month Trend Analysis\n\nFormat as JSON with these sections.",
        "options": {
          "systemMessage": "You are a CFO-level financial analyst. Provide clear, actionable insights based on financial data. Focus on business impact and strategic implications."
        }
      },
      "id": "ai-financial-analysis",
      "name": "AI Financial Analysis",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [1580, 400]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "claude-sonnet-4-20250514",
          "mode": "list",
          "cachedResultName": "claude-sonnet-4-20250514"
        },
        "options": {
          "temperature": 0.3
        }
      },
      "id": "anthropic-model",
      "name": "Claude Sonnet",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.2,
      "position": [1600, 600]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nlet aiAnalysis;\n\ntry {\n  aiAnalysis = JSON.parse(data.text || data.response);\n} catch (e) {\n  aiAnalysis = {\n    executive_summary: data.text || data.response,\n    highlights: [],\n    concerns: [],\n    recommendations: []\n  };\n}\n\nreturn [{\n  json: {\n    ...data,\n    analysis: aiAnalysis\n  }\n}];"
      },
      "id": "parse-analysis",
      "name": "Parse AI Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 400]
    },

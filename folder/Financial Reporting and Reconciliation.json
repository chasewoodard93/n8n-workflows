      "id": "respond-report",
      "name": "Respond Report Generated",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2680, 600]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ACCOUNTING_API_URL }}/api/reports/custom",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.ACCOUNTING_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"report_type\": \"{{ $json.report_type }}\",\n  \"start_date\": \"{{ $json.start_date }}\",\n  \"end_date\": \"{{ $json.end_date }}\",\n  \"include_sections\": [\"income_statement\", \"balance_sheet\", \"cash_flow\", \"ar_aging\"]\n}",
        "options": {}
      },
      "id": "generate-custom",
      "name": "Generate Custom Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 1040]
    },
    {
      "parameters": {
        "jsCode": "// Budget vs Actual variance analysis\nconst data = $input.first().json;\n\nconst variance = {\n  period: data.period,\n  categories: []\n};\n\nconst budget = data.budget || {};\nconst actual = data.income_statement || {};\n\nconst categories = [\n  { name: 'Revenue', budget_key: 'revenue', actual_key: 'revenue' },\n  { name: 'COGS', budget_key: 'cogs', actual_key: 'cost_of_goods_sold' },\n  { name: 'Operating Expenses', budget_key: 'opex', actual_key: 'operating_expenses' },\n  { name: 'Marketing', budget_key: 'marketing', actual_key: 'marketing_expense' },\n  { name: 'Payroll', budget_key: 'payroll', actual_key: 'payroll_expense' }\n];\n\nfor (const cat of categories) {\n  const budgetAmount = budget[cat.budget_key] || 0;\n  const actualAmount = actual[cat.actual_key] || 0;\n  const varianceAmount = actualAmount - budgetAmount;\n  const variancePct = budgetAmount > 0 ? (varianceAmount / budgetAmount * 100) : 0;\n  \n  variance.categories.push({\n    name: cat.name,\n    budget: budgetAmount,\n    actual: actualAmount,\n    variance: varianceAmount,\n    variance_pct: variancePct,\n    favorable: cat.name === 'Revenue' ? varianceAmount >= 0 : varianceAmount <= 0\n  });\n}\n\nreturn [{ json: { ...data, variance_analysis: variance } }];"
      },
      "id": "variance-analysis",
      "name": "Budget Variance Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2020, 300]
    }

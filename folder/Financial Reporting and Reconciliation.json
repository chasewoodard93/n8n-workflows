      "id": "merge-reconciliation",
      "name": "Merge Reconciliation Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1140, 820]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst bankTxns = items[0]?.json?.transactions || [];\nconst bookTxns = items[1]?.json?.transactions || [];\n\nconst reconciliation = {\n  date: items[0]?.json?.date,\n  bank_balance: items[0]?.json?.ending_balance,\n  book_balance: items[1]?.json?.ending_balance,\n  \n  matched: [],\n  bank_only: [],\n  book_only: [],\n  discrepancies: []\n};\n\n// Create lookup maps\nconst bankMap = new Map();\nconst bookMap = new Map();\n\nfor (const txn of bankTxns) {\n  const key = `${txn.amount}_${txn.reference || txn.description}`;\n  bankMap.set(key, txn);\n}\n\nfor (const txn of bookTxns) {\n  const key = `${txn.amount}_${txn.reference || txn.description}`;\n  bookMap.set(key, txn);\n}\n\n// Match transactions\nfor (const [key, bankTxn] of bankMap) {\n  if (bookMap.has(key)) {\n    reconciliation.matched.push({\n      bank: bankTxn,\n      book: bookMap.get(key)\n    });\n    bookMap.delete(key);\n  } else {\n    reconciliation.bank_only.push(bankTxn);\n  }\n}\n\n// Remaining book transactions\nfor (const [key, bookTxn] of bookMap) {\n  reconciliation.book_only.push(bookTxn);\n}\n\n// Calculate totals\nreconciliation.summary = {\n  matched_count: reconciliation.matched.length,\n  bank_only_count: reconciliation.bank_only.length,\n  book_only_count: reconciliation.book_only.length,\n  balance_difference: reconciliation.bank_balance - reconciliation.book_balance,\n  is_reconciled: reconciliation.bank_only.length === 0 && reconciliation.book_only.length === 0\n};\n\nreturn [{ json: reconciliation }];"
      },
      "id": "perform-reconciliation",
      "name": "Perform Reconciliation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, 820]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-discrepancies",
              "leftValue": "={{ $json.summary.bank_only_count + $json.summary.book_only_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "check-discrepancies",
      "name": "Has Discrepancies?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1580, 820]
    },

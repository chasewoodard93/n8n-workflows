    {
      "parameters": {
        "jsCode": "// Process CSAT survey response\nconst query = $input.first().json.query || $input.first().json;\n\nconst response = {\n  ticketId: query.ticket || '',\n  rating: parseInt(query.rating || '0'),\n  comment: query.comment || '',\n  submittedAt: new Date().toISOString()\n};\n\nreturn {\n  json: response\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 800],

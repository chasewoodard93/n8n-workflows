      "parameters": {
        "jsCode": "// Start SLA timer based on priority\nconst data = $input.first().json;\n\nconst slaConfig = {\n  critical: { response: 60, resolution: 240 }, // minutes\n  high: { response: 240, resolution: 480 },\n  medium: { response: 1440, resolution: 2880 },\n  low: { response: 2880, resolution: 5760 }\n};\n\nconst sla = slaConfig[data.priority] || slaConfig.medium;\n\nreturn {\n  json: {\n    ...data,\n    sla: {\n      responseDeadline: new Date(Date.now() + sla.response * 60000).toISOString(),\n      resolutionDeadline: new Date(Date.now() + sla.resolution * 60000).toISOString(),\n      responseMinutes: sla.response,\n      resolutionMinutes: sla.resolution\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, 400],
      "id": "sla-timer",
      "name": "Start SLA Timer"

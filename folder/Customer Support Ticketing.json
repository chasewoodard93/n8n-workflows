      "parameters": {
        "fromEmail": "support@company.com",
        "toEmail": "={{ $json.customerEmail }}",
        "subject": "=We received your request [{{ $json.id }}]",
        "text": "=Hi {{ $json.customerName }},\n\nThank you for contacting us. We've received your support request and a member of our {{ $json.assignedTo.replace(/-/g, ' ') }} team will be in touch shortly.\n\nTicket ID: {{ $json.id }}\nPriority: {{ $json.priority }}\nCategory: {{ $json.category }}\n\nExpected Response Time:\n{{ $json.priority === 'critical' ? '• Critical: Within 1 hour' : $json.priority === 'high' ? '• High: Within 4 hours' : $json.priority === 'medium' ? '• Medium: Within 24 hours' : '• Low: Within 48 hours' }}\n\nYou can reply to this email to add more information to your request.\n\nBest regards,\nSupport Team"
      },

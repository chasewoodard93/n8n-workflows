    {
      "parameters": {
        "jsCode": "// Parse and normalize support request from any channel\nconst input = $input.first().json;\n\nconst supportRequest = {\n  id: `TKT-${Date.now()}`,\n  receivedAt: new Date().toISOString(),\n  \n  // Customer info\n  customerEmail: input.from || input.email || input.customerEmail || '',\n  customerName: input.name || input.customerName || input.fromName || '',\n  customerId: input.customerId || '',\n  accountType: input.accountType || 'standard', // standard, premium, enterprise\n  \n  // Request details\n  subject: input.subject || input.title || 'Support Request',\n  body: input.body || input.text || input.message || input.description || '',\n  channel: input.channel || 'email', // email, form, chat, phone\n  \n  // Attachments\n  hasAttachments: (input.attachments && input.attachments.length > 0) || false,\n  attachments: input.attachments || [],\n  \n  // Context\n  productArea: input.product || '',\n  browserInfo: input.browser || '',\n  osInfo: input.os || '',\n  errorMessage: input.error || '',\n  \n  // Initial status\n  status: 'new',\n  priority: null, // Will be set by AI\n  category: null, // Will be set by AI\n  assignedTo: null\n};\n\nreturn {\n  json: supportRequest\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 200],
      "id": "parse-request",
      "name": "Parse Support Request"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-4-20250514"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a customer support AI assistant. Analyze this support request and categorize it.\n\nSubject: {{ $json.subject }}\nMessage: {{ $json.body }}\nProduct Area: {{ $json.productArea || 'Not specified' }}\nError Message: {{ $json.errorMessage || 'None' }}\nAccount Type: {{ $json.accountType }}\n\nProvide your analysis in JSON format:\n{\n  \"category\": \"technical|billing|account|feature_request|bug_report|general\",\n  \"subcategory\": \"specific subcategory\",\n  \"priority\": \"critical|high|medium|low\",\n  \"sentiment\": \"positive|neutral|negative|frustrated\",\n  \"canAutoResolve\": true/false,\n  \"suggestedResponse\": \"if canAutoResolve is true, provide a helpful response\",\n  \"knowledgeBaseMatch\": \"relevant KB article if applicable\",\n  \"escalationReason\": \"reason if needs escalation\",\n  \"summary\": \"brief summary of the issue\",\n  \"requiredSkills\": [\"list of skills needed to resolve\"]\n}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [440, 200],
      "id": "ai-categorize",
      "name": "AI Categorize and Prioritize",
      "credentials": {
        "anthropicApi": {
          "id": "anthropic-credentials",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "can-auto-resolve",
              "leftValue": "={{ $json.canAutoResolve }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 200],
      "id": "check-auto",
      "name": "Check for Auto-Resolution"
    },
    {
      "parameters": {

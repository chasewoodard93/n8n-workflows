        },
        "messages": {
          "values": [
            {
              "content": "=Generate a helpful, professional customer support response for this issue.\n\nCustomer Name: {{ $json.customerName }}\nIssue: {{ $json.subject }}\nDetails: {{ $json.body }}\nCategory: {{ $json.category }}\nKnowledge Base Match: {{ $json.knowledgeBaseMatch || 'None' }}\n\nWrite a friendly, helpful response that:\n1. Acknowledges their issue\n2. Provides a clear solution or next steps\n3. Offers additional help if needed\n4. Uses a professional but warm tone\n\nDo not include subject line - just the email body."
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [880, 100],

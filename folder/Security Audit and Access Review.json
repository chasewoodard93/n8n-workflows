        "messages": {
          "values": [
            {
              "content": "=Triage this security alert and provide response recommendations:\n\nAlert ID: {{ $json.id }}\nSource: {{ $json.source }}\nType: {{ $json.type }}\nInitial Severity: {{ $json.severity }}\nDescription: {{ $json.description }}\nAffected Assets: {{ JSON.stringify($json.affectedAssets) }}\nIndicators: {{ JSON.stringify($json.indicators) }}\n\nProvide triage in JSON:\n{\n  \"threatLevel\": \"critical|high|medium|low\",\n  \"threatType\": \"malware|phishing|intrusion|data_breach|dos|insider|other\",\n  \"confidence\": 0-100,\n  \"isFalsePositive\": true/false,\n  \"affectedScope\": \"description of impact\",\n  \"immediateActions\": [\"steps to take now\"],\n  \"containmentSteps\": [\"how to contain\"],\n  \"investigationSteps\": [\"what to investigate\"],\n  \"autoRemediateEligible\": true/false,\n  \"autoRemediateAction\": \"if eligible, what action\"\n}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",

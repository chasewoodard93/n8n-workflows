    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-4-20250514"
        },
        "messages": {
          "values": [
            {
              "content": "=Analyze these security events from the last 24 hours and identify any threats or anomalies:\n\n{{ JSON.stringify($json.events?.slice(0, 50) || $json, null, 2) }}\n\nProvide analysis in JSON format:\n{\n  \"summary\": \"brief summary of security posture\",\n  \"totalEvents\": number,\n  \"criticalFindings\": [\n    {\n      \"type\": \"type of finding\",\n      \"description\": \"details\",\n      \"severity\": \"critical|high|medium|low\",\n      \"affectedSystems\": [\"list\"],\n      \"recommendedAction\": \"what to do\"\n    }\n  ],\n  \"suspiciousPatterns\": [\"patterns detected\"],\n  \"failedLogins\": { \"count\": number, \"topSources\": [\"IPs\"] },\n  \"privilegedAccess\": { \"count\": number, \"unusual\": [\"activities\"] },\n  \"dataExfiltration\": { \"risk\": \"low|medium|high\", \"indicators\": [] },\n  \"overallRisk\": \"low|medium|high|critical\",\n  \"requiresImmediate\": true/false\n}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [440, 0],
      "id": "ai-events",
      "name": "AI Analyze Events",
      "credentials": {
        "anthropicApi": {
          "id": "anthropic-credentials",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "high-severity",
              "leftValue": "={{ $json.overallRisk === 'critical' || $json.overallRisk === 'high' || $json.requiresImmediate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 0],
      "id": "check-severity",
      "name": "Check Severity"
    },

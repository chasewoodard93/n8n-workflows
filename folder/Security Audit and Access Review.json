      "position": [880, 800],
      "id": "standard-queue",
      "name": "Standard Queue"
    },
    {
      "parameters": {
        "jsCode": "// Run compliance checks\nconst frameworks = ['SOC2', 'GDPR', 'HIPAA', 'PCI-DSS'];\nconst checkResults = [];\n\n// In production, this would query various systems\nframeworks.forEach(framework => {\n  checkResults.push({\n    framework,\n    totalControls: 100,\n    passing: Math.floor(Math.random() * 20) + 80, // Simulated\n    failing: Math.floor(Math.random() * 10),\n    notApplicable: Math.floor(Math.random() * 10),\n    lastChecked: new Date().toISOString()\n  });\n});\n\nreturn {\n  json: {\n    auditDate: new Date().toISOString(),\n    frameworks: checkResults,\n    overallScore: Math.floor(checkResults.reduce((sum, f) => sum + (f.passing / f.totalControls * 100), 0) / frameworks.length)\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 900],
      "id": "run-compliance",
      "name": "Run Compliance Checks"
    },
    {
      "parameters": {
        "jsCode": "// Generate compliance report\nconst data = $input.first().json;\n\nconst report = {\n  reportId: `COMP-${Date.now()}`,\n  generatedAt: data.auditDate,\n  overallScore: data.overallScore,\n  status: data.overallScore >= 90 ? 'compliant' : data.overallScore >= 70 ? 'needs_attention' : 'non_compliant',\n  frameworks: data.frameworks,\n  findings: data.frameworks.filter(f => f.failing > 0).map(f => ({\n    framework: f.framework,\n    failingControls: f.failing,\n    complianceRate: ((f.passing / f.totalControls) * 100).toFixed(1)\n  })),\n  nextAudit: new Date(Date.now() + 30 * 86400000).toISOString()\n};\n\nreturn {\n  json: report\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 900],
      "id": "gen-compliance-report",
      "name": "Generate Compliance Report"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [

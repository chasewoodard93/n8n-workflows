      "parameters": {
        "jsCode": "// Process incoming security alert\nconst alert = $input.first().json;\n\nconst processedAlert = {\n  id: `ALERT-${Date.now()}`,\n  receivedAt: new Date().toISOString(),\n  source: alert.source || 'unknown',\n  type: alert.type || alert.alertType || 'general',\n  severity: alert.severity || 'medium',\n  description: alert.description || alert.message || '',\n  affectedAssets: alert.assets || alert.hosts || [],\n  indicators: alert.indicators || alert.iocs || [],\n  rawData: alert\n};\n\nreturn {\n  json: processedAlert\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 600],
      "id": "process-alert",
      "name": "Process Alert"

        "jsCode": "const contract = $input.first().json;\nlet aiReview;\n\ntry {\n  aiReview = JSON.parse(contract.text || contract.response);\n} catch (e) {\n  aiReview = {\n    risk_assessment: 'Medium',\n    concerns: ['Unable to parse AI review'],\n    recommendation: 'Manual review required'\n  };\n}\n\nreturn [{\n  json: {\n    ...contract,\n    ai_review: aiReview\n  }\n}];"
      },

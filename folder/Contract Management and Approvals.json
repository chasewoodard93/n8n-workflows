        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<h2>Contract Approval Request</h2>\n<p>A contract requires your approval.</p>\n\n<div style=\"background: {{ $json.risk_level === 'high' ? '#ffebee' : $json.risk_level === 'medium' ? '#fff3e0' : '#e8f5e9' }}; padding: 15px; border-radius: 4px; margin: 20px 0;\">\n<p><strong>Contract ID:</strong> {{ $json.contract_id }}</p>\n<p><strong>Type:</strong> {{ $json.contract_type }}</p>\n<p><strong>Party:</strong> {{ $json.party_name }}</p>\n<p><strong>Value:</strong> ${{ $json.value.toLocaleString() }}</p>\n<p><strong>Term:</strong> {{ $json.start_date }} to {{ $json.end_date }}</p>\n<p><strong>Risk Level:</strong> {{ $json.risk_level.toUpperCase() }}</p>\n</div>\n\n<h3>AI Risk Assessment</h3>\n<p><strong>Recommendation:</strong> {{ $json.ai_review.recommendation }}</p>\n{{ $json.ai_review.concerns?.length > 0 ? `<p><strong>Concerns:</strong></p><ul>${$json.ai_review.concerns.map(c => '<li>' + c + '</li>').join('')}</ul>` : '' }}\n\n<div style=\"margin: 20px 0;\">\n<a href=\"{{ $env.CONTRACT_PORTAL_URL }}/approve/{{ $json.contract_id }}?action=approve\" style=\"background: #4CAF50; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px; margin-right: 10px;\">Approve</a>\n<a href=\"{{ $env.CONTRACT_PORTAL_URL }}/approve/{{ $json.contract_id }}?action=reject\" style=\"background: #f44336; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px;\">Reject</a>\n</div>\n\n<p><a href=\"{{ $env.CONTRACT_PORTAL_URL }}/contracts/{{ $json.contract_id }}\">View Full Contract</a></p>\n</div>",

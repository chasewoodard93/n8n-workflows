    {
      "parameters": {
        "jsCode": "const contract = $input.first().json;\n\n// Determine approval chain based on contract type and value\nlet approvalChain = [];\nlet riskLevel = 'low';\n\n// Value-based approvals\nif (contract.value > 100000) {\n  approvalChain.push({ role: 'legal', required: true });\n  approvalChain.push({ role: 'cfo', required: true });\n  approvalChain.push({ role: 'ceo', required: true });\n  riskLevel = 'high';\n} else if (contract.value > 25000) {\n  approvalChain.push({ role: 'legal', required: true });\n  approvalChain.push({ role: 'department_head', required: true });\n  riskLevel = 'medium';\n} else if (contract.value > 5000) {\n  approvalChain.push({ role: 'legal', required: contract.contract_type !== 'standard' });\n  approvalChain.push({ role: 'manager', required: true });\n  riskLevel = 'low';\n} else {\n  approvalChain.push({ role: 'manager', required: true });\n  riskLevel = 'minimal';\n}\n\n// Contract type specific requirements\nconst requiresLegalReview = ['custom', 'partnership', 'licensing', 'merger', 'acquisition'];\nif (requiresLegalReview.includes(contract.contract_type) && !approvalChain.find(a => a.role === 'legal')) {\n  approvalChain.unshift({ role: 'legal', required: true });\n}\n\nreturn [{\n  json: {\n    ...contract,\n    approval_chain: approvalChain,\n    current_approval_step: 0,\n    risk_level: riskLevel,\n    status: 'pending_approval',\n    created_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "determine-approvals",
      "name": "Determine Approval Chain",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Review this contract submission and provide a risk assessment:\n\nContract Type: {{ $json.contract_type }}\nParty: {{ $json.party_name }}\nValue: ${{ $json.value }}\nTerm: {{ $json.start_date }} to {{ $json.end_date }}\nTerms Summary: {{ $json.terms }}\n\nProvide:\n1. Risk Assessment (Low/Medium/High/Critical)\n2. Key concerns or red flags\n3. Recommended modifications or clauses\n4. Compliance considerations\n5. Summary recommendation (Approve/Approve with conditions/Reject/Escalate)\n\nFormat as JSON with these fields.",
        "options": {
          "systemMessage": "You are a legal contract analyst. Provide thorough risk assessments focusing on liability, compliance, and business impact."
        }
      },

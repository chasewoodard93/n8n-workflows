      "id": "fetch-pending",
      "name": "Fetch Pending Contracts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 520]
    },
    {
      "parameters": {
        "jsCode": "const contracts = $input.first().json.contracts || [];\nconst today = new Date();\n\nconst categorized = {\n  pending_approval: [],\n  pending_signature: [],\n  expiring_30_days: [],\n  expiring_60_days: [],\n  overdue_approval: []\n};\n\nfor (const contract of contracts) {\n  // Check pending approvals\n  if (contract.status === 'pending_approval') {\n    const submittedDate = new Date(contract.created_at);\n    const daysPending = Math.ceil((today - submittedDate) / (1000 * 60 * 60 * 24));\n    contract.days_pending = daysPending;\n    \n    if (daysPending > 5) {\n      categorized.overdue_approval.push(contract);\n    } else {\n      categorized.pending_approval.push(contract);\n    }\n  }\n  \n  // Check pending signatures\n  if (contract.status === 'pending_signature') {\n    categorized.pending_signature.push(contract);\n  }\n  \n  // Check expiring contracts\n  if (contract.status === 'active' && contract.end_date) {\n    const endDate = new Date(contract.end_date);\n    const daysUntilExpiry = Math.ceil((endDate - today) / (1000 * 60 * 60 * 24));\n    contract.days_until_expiry = daysUntilExpiry;\n    \n    if (daysUntilExpiry <= 30) {\n      categorized.expiring_30_days.push(contract);\n    } else if (daysUntilExpiry <= 60) {\n      categorized.expiring_60_days.push(contract);\n    }\n  }\n}\n\nreturn [{ json: categorized }];"
      },
      "id": "categorize-contracts",
      "name": "Categorize Contracts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 520]

        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<h2 style=\"color: #d32f2f;\">SLA Breach Alert</h2>\n<p>The following ticket has breached its SLA and requires immediate attention:</p>\n\n<div style=\"background: #ffebee; padding: 15px; border-radius: 4px; margin: 20px 0;\">\n<p><strong>Ticket ID:</strong> {{ $json.ticket_id }}</p>\n<p><strong>Subject:</strong> {{ $json.subject }}</p>\n<p><strong>Priority:</strong> {{ $json.priority }}</p>\n<p><strong>Resolution Deadline:</strong> {{ new Date($json.sla.resolution_deadline).toLocaleString() }}</p>\n<p><strong>Time Overdue:</strong> {{ Math.round((Date.now() - new Date($json.sla.resolution_deadline)) / (1000 * 60 * 60)) }} hours</p>\n</div>\n\n<p><strong>Action Required:</strong> Please escalate or resolve immediately.</p>\n\n<a href=\"{{ $env.IT_PORTAL_URL }}/agent/tickets/{{ $json.ticket_id }}\" style=\"background: #d32f2f; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px;\">Open Ticket Now</a>\n</div>",
        "options": {}
      },

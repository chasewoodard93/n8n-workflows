        "method": "GET",
        "url": "={{ $env.TICKETING_API_URL }}/api/tickets?status=open,assigned,in_progress",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.TICKETING_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-open-tickets",
      "name": "Fetch Open Tickets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 740]
    },
    {
      "parameters": {
        "jsCode": "const tickets = $input.first().json.tickets || [];\nconst now = new Date();\n\nconst slaStatus = {\n  breached_response: [],\n  breached_resolution: [],\n  at_risk_response: [],\n  at_risk_resolution: [],\n  on_track: []\n};\n\nfor (const ticket of tickets) {\n  const responseDeadline = new Date(ticket.sla?.response_deadline);\n  const resolutionDeadline = new Date(ticket.sla?.resolution_deadline);\n  \n  // Check response SLA\n  if (!ticket.first_response_at) {\n    if (now > responseDeadline) {\n      slaStatus.breached_response.push(ticket);\n    } else if ((responseDeadline - now) < 30 * 60 * 1000) { // 30 min warning\n      slaStatus.at_risk_response.push(ticket);\n    }\n  }\n  \n  // Check resolution SLA\n  if (ticket.status !== 'resolved' && ticket.status !== 'closed') {\n    if (now > resolutionDeadline) {\n      slaStatus.breached_resolution.push(ticket);\n    } else if ((resolutionDeadline - now) < 60 * 60 * 1000) { // 1 hour warning\n      slaStatus.at_risk_resolution.push(ticket);\n    } else {\n      slaStatus.on_track.push(ticket);\n    }\n  }\n}\n\nreturn [{ json: slaStatus }];"
      },
      "id": "check-sla-status",
      "name": "Check SLA Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 740]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [

    {
      "parameters": {
        "sendTo": "={{ $json.assigned_agent_email }}",
        "subject": "=New Ticket Assigned: {{ $json.subject }} [{{ $json.ticket_id }}]",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<h2>New Ticket Assigned to You</h2>\n\n<div style=\"background: {{ $json.priority === 'critical' ? '#ffebee' : $json.priority === 'high' ? '#fff3e0' : '#e3f2fd' }}; padding: 15px; border-radius: 4px; margin: 20px 0;\">\n<p><strong>Ticket ID:</strong> {{ $json.ticket_id }}</p>\n<p><strong>Priority:</strong> {{ $json.priority.toUpperCase() }}</p>\n<p><strong>Category:</strong> {{ $json.category }} / {{ $json.subcategory }}</p>\n<p><strong>Subject:</strong> {{ $json.subject }}</p>\n<p><strong>Requester:</strong> {{ $json.requester_email }}</p>\n</div>\n\n<h3>Description</h3>\n<p>{{ $json.description }}</p>\n\n<h3>SLA</h3>\n<p><strong>Response Due:</strong> {{ new Date($json.sla.response_deadline).toLocaleString() }}</p>\n<p><strong>Resolution Due:</strong> {{ new Date($json.sla.resolution_deadline).toLocaleString() }}</p>\n\n<p style=\"margin: 20px 0;\"><a href=\"{{ $env.IT_PORTAL_URL }}/agent/tickets/{{ $json.ticket_id }}\" style=\"background: #1976d2; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px;\">Open Ticket</a></p>\n</div>",
        "options": {}
      },
      "id": "email-agent",
      "name": "Email Assigned Agent",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [2460, 400],
      "credentials": {
        "smtp": {
          "id": "smtp-creds",
          "name": "SMTP"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $json.requester_email }}",
        "subject": "=Ticket Received: {{ $json.subject }} [{{ $json.ticket_id }}]",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<h2>We've Received Your Request</h2>\n<p>Thank you for contacting IT Support. Your ticket has been received and assigned to our team.</p>\n\n<div style=\"background: #f5f5f5; padding: 15px; border-radius: 4px; margin: 20px 0;\">\n<p><strong>Ticket ID:</strong> {{ $json.ticket_id }}</p>\n<p><strong>Subject:</strong> {{ $json.subject }}</p>\n<p><strong>Priority:</strong> {{ $json.priority }}</p>\n<p><strong>Status:</strong> {{ $json.status }}</p>\n</div>\n\n<p>You can expect a response within {{ $json.sla.response_hours }} hours.</p>\n\n<p><a href=\"{{ $env.IT_PORTAL_URL }}/tickets/{{ $json.ticket_id }}\">Track Your Ticket</a></p>\n\n<p style=\"font-size: 12px; color: #666;\">Please include your ticket ID ({{ $json.ticket_id }}) in any follow-up communications.</p>\n</div>",
        "options": {}
      },

    {
      "parameters": {
        "sendTo": "={{ $json.requester_email }}",
        "subject": "=Ticket Resolved: {{ $json.subject }} [{{ $json.ticket_id }}]",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<h2 style=\"color: #4CAF50;\">Your Ticket Has Been Resolved</h2>\n<p>Great news! Your support request has been resolved.</p>\n\n<div style=\"background: #e8f5e9; padding: 15px; border-radius: 4px; margin: 20px 0;\">\n<p><strong>Ticket ID:</strong> {{ $json.ticket_id }}</p>\n<p><strong>Subject:</strong> {{ $json.subject }}</p>\n<p><strong>Resolution:</strong> {{ $json.comment }}</p>\n</div>\n\n<p>If this issue persists or you need further assistance, please reply to this email or reopen your ticket.</p>\n\n<p>We'd appreciate your feedback:</p>\n<div style=\"margin: 20px 0;\">\n<a href=\"{{ $env.IT_PORTAL_URL }}/feedback/{{ $json.ticket_id }}?rating=5\" style=\"font-size: 24px; text-decoration: none;\">😊</a>\n<a href=\"{{ $env.IT_PORTAL_URL }}/feedback/{{ $json.ticket_id }}?rating=3\" style=\"font-size: 24px; text-decoration: none; margin-left: 10px;\">😐</a>\n<a href=\"{{ $env.IT_PORTAL_URL }}/feedback/{{ $json.ticket_id }}?rating=1\" style=\"font-size: 24px; text-decoration: none; margin-left: 10px;\">😞</a>\n</div>\n</div>",
        "options": {}
      },
      "id": "email-resolved",
      "name": "Email Resolution Notice",

    {
      "parameters": {
        "promptType": "define",
        "text": "Analyze this IT support ticket and classify it:\n\nSubject: {{ $json.subject }}\nDescription: {{ $json.description }}\nCategory (if provided): {{ $json.category }}\nPriority (if provided): {{ $json.priority }}\n\nDetermine:\n1. Category: hardware, software, network, security, access, email, printing, other\n2. Subcategory: more specific classification\n3. Priority: critical, high, medium, low\n4. Estimated complexity: simple, moderate, complex\n5. Suggested team: helpdesk, desktop_support, network_team, security_team, systems_admin\n6. Auto-resolution possible: true/false\n7. If auto-resolvable, provide step-by-step resolution\n8. Keywords for knowledge base search\n\nReturn as JSON.",
        "options": {
          "systemMessage": "You are an IT support specialist. Accurately classify tickets to ensure proper routing and SLA assignment."
        }
      },
      "id": "ai-classify",
      "name": "AI Classify Ticket",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [920, 300]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "claude-sonnet-4-20250514",
          "mode": "list",
          "cachedResultName": "claude-sonnet-4-20250514"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "anthropic-model",
      "name": "Claude Sonnet",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.2,
      "position": [940, 500]
    },
    {
      "parameters": {
        "jsCode": "const ticket = $input.first().json;\nlet classification;\n\ntry {\n  classification = JSON.parse(ticket.text || ticket.response);\n} catch (e) {\n  classification = {\n    category: ticket.category || 'other',\n    priority: ticket.priority || 'medium',\n    suggested_team: 'helpdesk',\n    auto_resolution_possible: false\n  };\n}\n\n// Determine SLA based on priority\nconst slaHours = {\n  critical: { response: 0.25, resolution: 4 },\n  high: { response: 1, resolution: 8 },\n  medium: { response: 4, resolution: 24 },\n  low: { response: 8, resolution: 72 }\n};\n\nconst priority = classification.priority || 'medium';\nconst sla = slaHours[priority];\n\nconst now = new Date();\nconst responseDeadline = new Date(now.getTime() + sla.response * 60 * 60 * 1000);\nconst resolutionDeadline = new Date(now.getTime() + sla.resolution * 60 * 60 * 1000);\n\nreturn [{\n  json: {\n    ...ticket,\n    classification: classification,\n    category: classification.category,\n    subcategory: classification.subcategory,\n    priority: classification.priority,\n    assigned_team: classification.suggested_team,\n    auto_resolution_possible: classification.auto_resolution_possible,\n    auto_resolution_steps: classification.auto_resolution_steps,\n    sla: {\n      response_hours: sla.response,\n      resolution_hours: sla.resolution,\n      response_deadline: responseDeadline.toISOString(),\n      resolution_deadline: resolutionDeadline.toISOString()\n    },\n    status: 'new',\n    created_at: now.toISOString()\n  }\n}];"
      },
      "id": "process-classification",
      "name": "Process Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "auto-resolve",
              "leftValue": "={{ $json.auto_resolution_possible }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "check-auto-resolve",
      "name": "Can Auto-Resolve?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1360, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.requester_email }}",
        "subject": "=Re: {{ $json.subject }} [{{ $json.ticket_id }}]",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<h2>Automated Resolution</h2>\n<p>Hi there,</p>\n<p>Based on your request, here are the steps to resolve your issue:</p>\n\n<div style=\"background: #e3f2fd; padding: 15px; border-radius: 4px; margin: 20px 0;\">\n<h3>Resolution Steps:</h3>\n<ol>\n{{ $json.auto_resolution_steps.map(step => `<li>${step}</li>`).join('') }}\n</ol>\n</div>\n\n<p>If these steps resolve your issue, no further action is needed and your ticket will be automatically closed in 24 hours.</p>\n\n<p>If you still need assistance, please reply to this email or click below:</p>\n\n<a href=\"{{ $env.IT_PORTAL_URL }}/tickets/{{ $json.ticket_id }}/escalate\" style=\"background: #1976d2; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px;\">I Still Need Help</a>\n\n<p style=\"margin-top: 20px; font-size: 12px; color: #666;\">Ticket ID: {{ $json.ticket_id }}</p>\n</div>",
        "options": {}
      },
      "id": "send-auto-resolution",
      "name": "Send Auto-Resolution",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1580, 200],
      "credentials": {
        "smtp": {
          "id": "smtp-creds",
          "name": "SMTP"
        }
      }
    },

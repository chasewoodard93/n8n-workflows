      "name": "Find Available Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1800, 400]
    },
    {
      "parameters": {
        "jsCode": "const ticket = $input.first().json;\nconst agents = ticket.available_agents || [];\n\n// Round-robin or load-based assignment\nlet assignedAgent = null;\n\nif (agents.length > 0) {\n  // Sort by current workload (fewest open tickets)\n  agents.sort((a, b) => (a.open_tickets || 0) - (b.open_tickets || 0));\n  assignedAgent = agents[0];\n}\n\nreturn [{\n  json: {\n    ...ticket,\n    assigned_agent: assignedAgent,\n    assigned_agent_id: assignedAgent?.id,\n    assigned_agent_email: assignedAgent?.email,\n    status: assignedAgent ? 'assigned' : 'unassigned'\n  }\n}];"
      },
      "id": "assign-agent",
      "name": "Assign Agent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2020, 400]
    },

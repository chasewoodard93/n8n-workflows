        "jsCode": "// Track distribution analytics\nconst items = $input.all();\nconst analytics = [];\n\nfor (const item of items) {\n  analytics.push({\n    json: {\n      event: 'content_distributed',\n      content_id: item.json.original_id,\n      content_title: item.json.original_title,\n      channel: item.json.channel,\n      canonical_url: item.json.canonical_url,\n      distributed_at: new Date().toISOString(),\n      tracking_params: {\n        utm_source: item.json.channel,\n        utm_medium: 'syndication',\n        utm_campaign: 'content_distribution'\n      }\n    }\n  });\n}\n\nreturn analytics;"
      },
      "id": "track-analytics",
      "name": "Track Distribution Analytics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 700]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ANALYTICS_ENDPOINT }}/api/events",

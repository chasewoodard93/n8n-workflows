    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst summary = {\n  total_distributed: items.length,\n  channels: {},\n  successes: 0,\n  failures: 0,\n  content_items: []\n};\n\nfor (const item of items) {\n  const channel = item.json.channel;\n  const success = !item.json.error;\n  \n  if (!summary.channels[channel]) {\n    summary.channels[channel] = { success: 0, failed: 0 };\n  }\n  \n  if (success) {\n    summary.channels[channel].success++;\n    summary.successes++;\n  } else {\n    summary.channels[channel].failed++;\n    summary.failures++;\n  }\n  \n  summary.content_items.push({\n    original_title: item.json.original_title,\n    channel: channel,\n    status: success ? 'distributed' : 'failed',\n    url: item.json.published_url || item.json.canonical_url\n  });\n}\n\nreturn [{ json: summary }];"
      },
      "id": "summarize-distribution",
      "name": "Summarize Distribution",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2700, 520]

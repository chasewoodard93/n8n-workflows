    {
      "parameters": {
        "promptType": "define",
        "text": "Analyze this content and create distribution-ready versions for multiple channels.\n\nOriginal Content:\nTitle: {{ $json.title }}\nType: {{ $json.content_type }}\nURL: {{ $json.url }}\nExcerpt: {{ $json.excerpt }}\nFull Content: {{ $json.content }}\nTarget Audience: {{ $json.target_audience }}\nKeywords: {{ $json.keywords }}\n\nCreate optimized versions for these distribution channels:\n1. LinkedIn Article/Post\n2. Medium Article\n3. Dev.to Post (if technical)\n4. Email Newsletter Snippet\n5. Partner Syndication Summary\n6. Press Release Format (if newsworthy)\n7. Podcast Show Notes (if applicable)\n8. Video Script Outline (for repurposing)\n\nFor each channel provide:\n- Adapted title\n- Optimized content/summary\n- Hashtags/tags\n- Call-to-action\n- Canonical URL reference\n- SEO considerations\n\nReturn as structured JSON with channel-specific content.",
        "options": {
          "systemMessage": "You are a content distribution specialist. Adapt content for each platform while maintaining the core message and SEO value. Always include canonical URL references to avoid duplicate content issues."
        }
      },
      "id": "ai-content-adaptation",
      "name": "AI Content Adaptation",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [1560, 420]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "claude-sonnet-4-20250514",
          "mode": "list",
          "cachedResultName": "claude-sonnet-4-20250514"
        },
        "options": {
          "temperature": 0.5
        }
      },
      "id": "anthropic-model",
      "name": "Claude Sonnet",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.2,
      "position": [1580, 640]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.all();\nconst results = [];\n\nfor (const item of input) {\n  try {\n    const aiResponse = JSON.parse(item.json.text || item.json.response);\n    const originalContent = item.json;\n    \n    // Create distribution items for each channel\n    const channels = ['linkedin', 'medium', 'devto', 'newsletter', 'syndication', 'press', 'podcast', 'video'];\n    \n    for (const channel of channels) {\n      if (aiResponse[channel] && aiResponse[channel].content) {\n        results.push({\n          json: {\n            channel: channel,\n            original_url: originalContent.url,\n            original_title: originalContent.title,\n            original_id: originalContent.id,\n            adapted_title: aiResponse[channel].title,\n            adapted_content: aiResponse[channel].content,\n            hashtags: aiResponse[channel].hashtags || [],\n            tags: aiResponse[channel].tags || [],\n            cta: aiResponse[channel].cta,\n            canonical_url: originalContent.url,\n            seo_notes: aiResponse[channel].seo_notes,\n            ready_to_publish: true\n          }\n        });\n      }\n    }\n  } catch (e) {\n    results.push({\n      json: {\n        error: 'Failed to parse AI response',\n        original: item.json\n      }\n    });\n  }\n}\n\nreturn results;"
      },

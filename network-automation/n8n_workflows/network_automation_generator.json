        "sendBody": true,
        "bodyParameters": {
          "values": [
            {
              "name": "model",
              "value": "claude-3-5-sonnet-20241022"
            },
            {
              "name": "max_tokens",
              "value": "4000"
            },
            {
              "name": "messages",
              "value": "[{\"role\": \"user\", \"content\": \"You are an expert network automation engineer specializing in Nornir and Python. Your task is to analyze user requirements and create comprehensive network automation workflows.\\n\\nYou will receive project requirements and must:\\n1. Analyze the automation task and device types\\n2. Design the optimal Nornir workflow structure\\n3. Identify required Nornir plugins and Python libraries\\n4. Create detailed task specifications\\n5. Plan testing strategies\\n6. Generate implementation roadmap\\n\\nRespond with a structured JSON containing:\\n- workflow_design: Detailed workflow structure\\n- required_plugins: List of Nornir plugins needed\\n- python_dependencies: Required Python packages\\n- task_specifications: Detailed task definitions\\n- testing_plan: Comprehensive testing strategy\\n- implementation_steps: Step-by-step implementation plan\\n\\nProject Requirements:\\n\\nProject Name: {{ $('Project Requirements Form').first().json.project_name }}\\nTask Type: {{ $('Project Requirements Form').first().json.automation_task_type }}\\nDevice Types: {{ $('Project Requirements Form').first().json.target_device_types }}\\nInventory Source: {{ $('Project Requirements Form').first().json.device_inventory_source }}\\nAuthentication: {{ $('Project Requirements Form').first().json.authentication_method }}\\nSecrets Management: {{ $('Project Requirements Form').first().json.secrets_management }}\\nVariables: {{ $('Project Requirements Form').first().json.required_variables }}\\nSpecial Requirements: {{ $('Project Requirements Form').first().json.special_requirements }}\\nTesting Environment: {{ $('Project Requirements Form').first().json.testing_environment }}\\n\\nPlease analyze these requirements and provide a comprehensive automation design.\"}]"
            }
          ]
        },
        "options": {}
      },

        "sendTo": "={{ $json.manager.email }}",
        "subject": "=PTO Request: {{ $json.employee_name }} - {{ $json.start_date }} to {{ $json.end_date }}",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<h2>PTO Approval Request</h2>\n<p>{{ $json.employee_name }} has requested time off and needs your approval.</p>\n\n<div style=\"background: #e3f2fd; padding: 15px; border-radius: 4px; margin: 20px 0;\">\n<p><strong>Request ID:</strong> {{ $json.request_id }}</p>\n<p><strong>Employee:</strong> {{ $json.employee_name }}</p>\n<p><strong>Leave Type:</strong> {{ $json.leave_type }}</p>\n<p><strong>Dates:</strong> {{ $json.start_date }} to {{ $json.end_date }}</p>\n<p><strong>Days Requested:</strong> {{ $json.days_requested }}</p>\n<p><strong>Reason:</strong> {{ $json.reason || 'Not specified' }}</p>\n</div>\n\n<div style=\"background: #f5f5f5; padding: 15px; border-radius: 4px; margin: 20px 0;\">\n<h4>Leave Balance</h4>\n<p><strong>Available:</strong> {{ $json.available_balance }} days</p>\n<p><strong>After Approval:</strong> {{ $json.remaining_after_approval }} days</p>\n{{ $json.has_team_conflicts ? '<p style=\"color: #ff9800;\">⚠️ Note: Team member conflict detected during this period</p>' : '' }}\n</div>\n\n<div style=\"margin: 20px 0;\">\n<a href=\"{{ $env.PTO_PORTAL_URL }}/approve/{{ $json.request_id }}?action=approve\" style=\"background: #4CAF50; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px; margin-right: 10px;\">Approve</a>\n<a href=\"{{ $env.PTO_PORTAL_URL }}/approve/{{ $json.request_id }}?action=reject\" style=\"background: #f44336; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px;\">Deny</a>\n</div>\n</div>",
        "options": {}
      },

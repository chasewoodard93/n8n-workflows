      "parameters": {
        "method": "GET",
        "url": "={{ $env.HRIS_API_URL }}/api/employees/{{ $json.employee_id }}/leave-balance",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.HRIS_API_KEY }}"
            }
          ]

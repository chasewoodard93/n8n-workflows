      },
      "id": "respond-decision",
      "name": "Respond Decision",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2460, 520]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.HRIS_API_URL }}/api/leave?date={{ new Date().toISOString().split('T')[0] }}&upcoming=7",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.HRIS_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-leave-today",
      "name": "Fetch Today's Leave",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 740]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst today = new Date().toISOString().split('T')[0];\n\nconst summary = {\n  date: today,\n  out_today: data.out_today || [],\n  returning_today: data.returning_today || [],\n  starting_leave_tomorrow: data.starting_tomorrow || [],\n  upcoming_week: data.upcoming_week || []\n};\n\nsummary.out_today_count = summary.out_today.length;\nsummary.returning_count = summary.returning_today.length;\n\nreturn [{ json: summary }];"
      },
      "id": "compile-daily",
      "name": "Compile Daily Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 740]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-leave",
              "leftValue": "={{ $json.out_today_count + $json.returning_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "check-any-leave",
      "name": "Any Leave Activity?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1360, 740]
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_GENERAL_CHANNEL }}",
        "text": "=📅 *Daily Leave Update - {{ $json.date }}*",
        "otherOptions": {},
        "attachments": [
          {
            "color": "#2196f3",
            "fields": {
              "item": [
                {
                  "title": "🏖️ Out Today",
                  "value": "={{ $json.out_today.length > 0 ? $json.out_today.map(e => e.name).join(', ') : 'No one' }}",
                  "short": false
                },
                {
                  "title": "👋 Returning Today",
                  "value": "={{ $json.returning_today.length > 0 ? $json.returning_today.map(e => e.name).join(', ') : 'No one' }}",
                  "short": false
                },
                {
                  "title": "📆 Starting Leave Tomorrow",
                  "value": "={{ $json.starting_leave_tomorrow.length > 0 ? $json.starting_leave_tomorrow.map(e => e.name).join(', ') : 'No one' }}",
                  "short": false
                }
              ]
            }
          }
        ]
      },

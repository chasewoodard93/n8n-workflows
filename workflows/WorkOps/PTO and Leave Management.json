      "id": "fetch-balance",
      "name": "Fetch Leave Balance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "jsCode": "const request = $input.first().json;\nconst balance = request.leave_balance || {};\n\n// Calculate business days requested\nconst startDate = new Date(request.start_date);\nconst endDate = new Date(request.end_date);\nlet businessDays = 0;\n\nfor (let d = new Date(startDate); d <= endDate; d.setDate(d.getDate() + 1)) {\n  const day = d.getDay();\n  if (day !== 0 && day !== 6) {\n    businessDays++;\n  }\n}\n\n// Get available balance for leave type\nconst leaveTypeBalances = {\n  'vacation': balance.vacation_days || 0,\n  'sick': balance.sick_days || 0,\n  'personal': balance.personal_days || 0,\n  'bereavement': 5, // Usually unlimited/policy-based\n  'jury_duty': 999, // Usually unlimited\n  'parental': balance.parental_leave || 0,\n  'unpaid': 999 // Unpaid leave usually approved case-by-case\n};\n\nconst availableBalance = leaveTypeBalances[request.leave_type] || 0;\nconst hasSufficientBalance = businessDays <= availableBalance;\n\n// Check for blackout dates or team conflicts\nconst teamConflicts = request.team_leave_dates || [];\nconst hasConflicts = teamConflicts.some(leave => {\n  const leaveStart = new Date(leave.start_date);\n  const leaveEnd = new Date(leave.end_date);\n  return (startDate <= leaveEnd && endDate >= leaveStart);\n});\n\nreturn [{\n  json: {\n    ...request,\n    days_requested: businessDays,\n    available_balance: availableBalance,\n    remaining_after_approval: availableBalance - businessDays,\n    has_sufficient_balance: hasSufficientBalance,\n    has_team_conflicts: hasConflicts,\n    status: 'pending_approval',\n    submitted_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "validate-request",
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-balance",
              "leftValue": "={{ $json.has_sufficient_balance }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "check-balance",
      "name": "Has Sufficient Balance?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1360, 300]

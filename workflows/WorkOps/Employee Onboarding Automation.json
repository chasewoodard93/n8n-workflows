    {
      "parameters": {
        "jsCode": "const employee = $input.first().json;\n\n// Generate work email\nconst workEmail = `${employee.first_name.toLowerCase()}.${employee.last_name.toLowerCase()}@${process.env.COMPANY_DOMAIN || 'company.com'}`;\n\n// Generate username\nconst username = `${employee.first_name.toLowerCase()}${employee.last_name.charAt(0).toLowerCase()}`;\n\n// Generate temporary password\nconst tempPassword = `Welcome${Date.now().toString(36).toUpperCase()}!`;\n\nreturn [{\n  json: {\n    ...employee,\n    work_email: workEmail,\n    username: username,\n    temp_password: tempPassword,\n    onboarding_status: 'in_progress',\n    onboarding_started: new Date().toISOString()\n  }\n}];"
      },
      "id": "generate-credentials",
      "name": "Generate Credentials",
      "type": "n8n-nodes-base.code",

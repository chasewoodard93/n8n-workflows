    {
      "parameters": {
        "sendTo": "={{ $json.personal_email }}",
        "subject": "=Welcome to the Team, {{ $json.first_name }}! 🎉",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n{{ $json.text || $json.response }}\n\n<div style=\"background: #e3f2fd; padding: 20px; border-radius: 8px; margin: 20px 0;\">\n<h3>Your Account Details</h3>\n<p><strong>Work Email:</strong> {{ $json.work_email }}</p>\n<p><strong>Username:</strong> {{ $json.username }}</p>\n<p><strong>Temporary Password:</strong> {{ $json.temp_password }}</p>\n<p style=\"color: #d32f2f;\"><em>Please change your password upon first login.</em></p>\n</div>\n\n<h3>Next Steps</h3>\n<ol>\n<li>Complete your onboarding documents (sent separately via DocuSign)</li>\n<li>Log in to your email and change your password</li>\n<li>Join our Slack workspace</li>\n<li>Review the employee handbook</li>\n</ol>\n\n<p>If you have any questions before your start date, please reach out to HR at {{ $env.HR_EMAIL }}.</p>\n\n<p>We're excited to have you join us!</p>\n</div>",
        "options": {}
      },
      "id": "send-welcome-email",
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [2440, 400],
      "credentials": {
        "smtp": {
          "id": "smtp-creds",
          "name": "SMTP"

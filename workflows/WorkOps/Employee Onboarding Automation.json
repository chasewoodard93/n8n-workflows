    {
      "parameters": {
        "jsCode": "const employee = $input.first().json;\n\n// Determine required documents based on employment type and location\nconst documents = [\n  { name: 'W-4 Tax Withholding', required: true, category: 'tax' },\n  { name: 'I-9 Employment Eligibility', required: true, category: 'legal' },\n  { name: 'Direct Deposit Form', required: true, category: 'payroll' },\n  { name: 'Emergency Contact Form', required: true, category: 'hr' },\n  { name: 'Employee Handbook Acknowledgment', required: true, category: 'policy' },\n  { name: 'Confidentiality Agreement', required: true, category: 'legal' },\n  { name: 'Non-Compete Agreement', required: employee.employment_type === 'full_time', category: 'legal' },\n  { name: 'Benefits Enrollment', required: employee.employment_type === 'full_time', category: 'benefits' },\n  { name: 'Remote Work Agreement', required: employee.location === 'remote', category: 'policy' }\n];\n\nreturn [{\n  json: {\n    ...employee,\n    required_documents: documents.filter(d => d.required),\n    documents_pending: documents.filter(d => d.required).length,\n    documents_completed: 0\n  }\n}];"
      },
      "id": "determine-documents",
      "name": "Determine Required Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 400]
    },

    {
      "parameters": {
        "jsCode": "const evaluation = $input.first().json;\nconst vendor = evaluation.vendor;\n\n// Calculate overall score\nconst overallScore = (\n  evaluation.quality_score + \n  evaluation.delivery_score + \n  evaluation.price_score + \n  evaluation.service_score\n) / 4;\n\n// Determine rating category\nlet rating;\nif (overallScore >= 4.5) rating = 'Excellent';\nelse if (overallScore >= 4) rating = 'Good';\nelse if (overallScore >= 3) rating = 'Satisfactory';\nelse if (overallScore >= 2) rating = 'Needs Improvement';\nelse rating = 'Poor';\n\n// Check if score is declining\nconst previousScore = vendor.avg_performance_score || overallScore;\nconst scoreTrend = overallScore > previousScore ? 'improving' : \n                   overallScore < previousScore ? 'declining' : 'stable';\n\nreturn [{\n  json: {\n    vendor_id: evaluation.vendor_id,\n    vendor_name: vendor.company_name,\n    vendor_email: vendor.contact_email,\n    evaluator_id: evaluation.evaluator_id,\n    scores: {\n      quality: evaluation.quality_score,\n      delivery: evaluation.delivery_score,\n      price: evaluation.price_score,\n      service: evaluation.service_score\n    },\n    overall_score: overallScore,\n    rating: rating,\n    previous_score: previousScore,\n    score_trend: scoreTrend,\n    comments: evaluation.comments,\n    evaluated_at: new Date().toISOString(),\n    requires_review: overallScore < 3 || scoreTrend === 'declining'\n  }\n}];"
      },
      "id": "process-evaluation",
      "name": "Process Evaluation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 740]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VENDOR_API_URL }}/api/vendors/{{ $json.vendor_id }}/evaluations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.VENDOR_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "save-evaluation",
      "name": "Save Evaluation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 740]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "needs-review",
              "leftValue": "={{ $json.requires_review }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "check-review",
      "name": "Requires Review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1580, 740]
    },
    {
      "parameters": {
        "sendTo": "={{ $env.PROCUREMENT_MANAGER_EMAIL }}",
        "subject": "=Vendor Performance Alert: {{ $json.vendor_name }} - {{ $json.rating }}",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<h2 style=\"color: {{ $json.overall_score < 3 ? '#d32f2f' : '#ff9800' }};\">Vendor Performance Alert</h2>\n<p>A vendor evaluation requires your attention.</p>\n\n<div style=\"background: {{ $json.overall_score < 3 ? '#ffebee' : '#fff3e0' }}; padding: 15px; border-radius: 4px; margin: 20px 0;\">\n<p><strong>Vendor:</strong> {{ $json.vendor_name }}</p>\n<p><strong>Overall Score:</strong> {{ $json.overall_score.toFixed(1) }}/5 ({{ $json.rating }})</p>\n<p><strong>Trend:</strong> {{ $json.score_trend }}</p>\n<p><strong>Previous Score:</strong> {{ $json.previous_score.toFixed(1) }}/5</p>\n</div>\n\n<h3>Score Breakdown</h3>\n<table style=\"width: 100%; border-collapse: collapse;\">\n<tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Quality</td><td style=\"padding: 8px; border: 1px solid #ddd;\">{{ $json.scores.quality }}/5</td></tr>\n<tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Delivery</td><td style=\"padding: 8px; border: 1px solid #ddd;\">{{ $json.scores.delivery }}/5</td></tr>\n<tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Price</td><td style=\"padding: 8px; border: 1px solid #ddd;\">{{ $json.scores.price }}/5</td></tr>\n<tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Service</td><td style=\"padding: 8px; border: 1px solid #ddd;\">{{ $json.scores.service }}/5</td></tr>\n</table>\n\n{{ $json.comments ? `<h3>Comments</h3><p>${$json.comments}</p>` : '' }}\n\n<p><a href=\"{{ $env.VENDOR_PORTAL_URL }}/admin/vendors/{{ $json.vendor_id }}/performance\" style=\"background: #1976d2; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px;\">Review Vendor</a></p>\n</div>",
        "options": {}
      },
      "id": "email-eval-alert",
      "name": "Email Evaluation Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1800, 680],
      "credentials": {
        "smtp": {
          "id": "smtp-creds",
          "name": "SMTP"
        }
      }
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_PROCUREMENT_CHANNEL }}",
        "text": "=📝 *Vendor Evaluation Submitted*",
        "otherOptions": {},
        "attachments": [
          {
            "color": "={{ $json.overall_score >= 4 ? '#4caf50' : $json.overall_score >= 3 ? '#ff9800' : '#d32f2f' }}",
            "fields": {
              "item": [
                {
                  "title": "Vendor",
                  "value": "={{ $json.vendor_name }}",
                  "short": true
                },
                {
                  "title": "Score",
                  "value": "={{ $json.overall_score.toFixed(1) }}/5",
                  "short": true
                },
                {
                  "title": "Rating",
                  "value": "={{ $json.rating }}",
                  "short": true
                },
                {
                  "title": "Trend",
                  "value": "={{ $json.score_trend }}",
                  "short": true
                }
              ]
            }
          }
        ]
      },
      "id": "slack-eval",
      "name": "Slack Evaluation Notice",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1800, 840],
      "credentials": {
        "slackApi": {
          "id": "slack-creds",
          "name": "Slack API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, vendor_id: $json.vendor_id, overall_score: $json.overall_score, rating: $json.rating }) }}",
        "options": {}
      },

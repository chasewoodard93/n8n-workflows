      "id": "merge-data",
      "name": "Merge Vendor Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1140, 580]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst vendors = items[0]?.json?.vendors || [];\nconst performance = items[1]?.json?.performance || {};\n\nconst analysis = {\n  total_vendors: vendors.length,\n  by_category: {},\n  expiring_contracts: [],\n  expiring_insurance: [],\n  low_performers: [],\n  top_performers: [],\n  requires_attention: []\n};\n\nconst today = new Date();\nconst thirtyDays = new Date(today.getTime() + 30 * 24 * 60 * 60 * 1000);\n\nfor (const vendor of vendors) {\n  // Category count\n  analysis.by_category[vendor.category] = (analysis.by_category[vendor.category] || 0) + 1;\n  \n  // Check contract expiration\n  if (vendor.contract_end_date) {\n    const contractEnd = new Date(vendor.contract_end_date);\n    if (contractEnd <= thirtyDays) {\n      analysis.expiring_contracts.push({\n        vendor_id: vendor.id,\n        name: vendor.company_name,\n        expires: vendor.contract_end_date,\n        days_remaining: Math.ceil((contractEnd - today) / (1000 * 60 * 60 * 24))\n      });\n    }\n  }\n  \n  // Check insurance expiration\n  if (vendor.insurance_expiry) {\n    const insuranceEnd = new Date(vendor.insurance_expiry);\n    if (insuranceEnd <= thirtyDays) {\n      analysis.expiring_insurance.push({\n        vendor_id: vendor.id,\n        name: vendor.company_name,\n        expires: vendor.insurance_expiry\n      });\n    }\n  }\n  \n  // Performance analysis\n  const vendorPerf = performance[vendor.id];\n  if (vendorPerf) {\n    const avgScore = (vendorPerf.quality + vendorPerf.delivery + vendorPerf.price + vendorPerf.service) / 4;\n    vendor.avg_score = avgScore;\n    \n    if (avgScore < 3) {\n      analysis.low_performers.push({ ...vendor, avg_score: avgScore });\n      analysis.requires_attention.push({ ...vendor, reason: 'Low performance score' });\n    } else if (avgScore >= 4.5) {\n      analysis.top_performers.push({ ...vendor, avg_score: avgScore });\n    }\n  }\n}\n\n// Sort performers\nanalysis.low_performers.sort((a, b) => a.avg_score - b.avg_score);\nanalysis.top_performers.sort((a, b) => b.avg_score - a.avg_score);\n\nreturn [{ json: analysis }];"
      },
      "id": "analyze-vendors",
      "name": "Analyze Vendor Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, 580]
    },

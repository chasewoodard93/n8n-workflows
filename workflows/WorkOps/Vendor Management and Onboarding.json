      "parameters": {
        "jsCode": "const vendor = $input.first().json;\n\n// Determine required documents based on vendor type\nconst requiredDocs = [\n  { name: 'W-9 Tax Form', required: true },\n  { name: 'Certificate of Insurance', required: true },\n  { name: 'Business License', required: true },\n  { name: 'Bank Account Info', required: true }\n];\n\n// Additional requirements for certain categories\nconst categoryDocs = {\n  'technology': [{ name: 'SOC 2 Report', required: true }, { name: 'Security Questionnaire', required: true }],\n  'construction': [{ name: 'OSHA Compliance', required: true }, { name: 'Workers Comp Certificate', required: true }],\n  'food': [{ name: 'Health Department License', required: true }, { name: 'Food Safety Certification', required: true }],\n  'professional_services': [{ name: 'Professional License', required: true }, { name: 'E&O Insurance', required: true }]\n};\n\nconst additionalDocs = categoryDocs[vendor.category] || [];\n\nreturn [{\n  json: {\n    ...vendor,\n    required_documents: [...requiredDocs, ...additionalDocs],\n    documents_pending: requiredDocs.length + additionalDocs.length,\n    documents_received: 0,\n    status: 'pending_documents',\n    onboarding_started: new Date().toISOString()\n  }\n}];"
      },

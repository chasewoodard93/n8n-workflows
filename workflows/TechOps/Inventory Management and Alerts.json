          "name": "SMTP"
        }
      }
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_OPS_CHANNEL }}",
        "text": "=📦 *Daily Inventory Report*",
        "otherOptions": {},
        "attachments": [
          {
            "color": "={{ $json.out_of_stock.length > 0 ? '#d32f2f' : $json.low_stock.length > 0 ? '#ff9800' : '#4caf50' }}",
            "fields": {
              "item": [
                {
                  "title": "Out of Stock",
                  "value": "={{ $json.out_of_stock.length }} items",
                  "short": true
                },

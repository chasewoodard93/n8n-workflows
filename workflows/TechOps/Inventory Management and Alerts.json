                }
              ]
            }
          }
        ]
      },
      "id": "slack-inventory",
      "name": "Slack Inventory Report",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1800, 360],
      "credentials": {
        "slackApi": {
          "id": "slack-creds",
          "name": "Slack API"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.INVENTORY_API_URL }}/api/products/{{ $json.sku }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INVENTORY_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-product",
      "name": "Fetch Product",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 520]
    },
    {
      "parameters": {
        "jsCode": "const update = $input.first().json;\nconst product = update.product;\n\n// Calculate new quantity\nlet newQuantity = product.quantity_on_hand || 0;\n\nswitch (update.change_type) {\n  case 'receipt':\n  case 'return':\n  case 'adjustment_add':\n    newQuantity += Math.abs(update.quantity_change);\n    break;\n  case 'sale':\n  case 'transfer_out':\n  case 'damage':\n  case 'adjustment_subtract':\n    newQuantity -= Math.abs(update.quantity_change);\n    break;\n}\n\n// Ensure non-negative\nnewQuantity = Math.max(0, newQuantity);\n\n// Check if new quantity triggers alert\nconst reorderPoint = product.reorder_point || 10;\nconst triggerAlert = newQuantity <= reorderPoint && product.quantity_on_hand > reorderPoint;\n\nreturn [{\n  json: {\n    ...update,\n    product: product,\n    previous_quantity: product.quantity_on_hand,\n    new_quantity: newQuantity,\n    trigger_low_stock_alert: triggerAlert,\n    is_out_of_stock: newQuantity === 0,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "calculate-change",
      "name": "Calculate Quantity Change",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 520]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.INVENTORY_API_URL }}/api/products/{{ $json.sku }}/stock",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INVENTORY_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"quantity_on_hand\": {{ $json.new_quantity }},\n  \"last_updated\": \"{{ $json.timestamp }}\",\n  \"change_type\": \"{{ $json.change_type }}\",\n  \"change_amount\": {{ $json.quantity_change }},\n  \"reference\": \"{{ $json.reference }}\",\n  \"location\": \"{{ $json.location }}\"\n}",
        "options": {}
      },
      "id": "update-stock",
      "name": "Update Stock Level",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 520]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "low-stock",
              "leftValue": "={{ $json.trigger_low_stock_alert || $json.is_out_of_stock }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "check-alert",
      "name": "Trigger Alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1580, 520]
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_OPS_CHANNEL }}",
        "text": "={{ $json.is_out_of_stock ? '🚨 *OUT OF STOCK*' : '⚠️ *Low Stock Alert*' }}",
        "otherOptions": {},
        "attachments": [
          {
            "color": "={{ $json.is_out_of_stock ? '#d32f2f' : '#ff9800' }}",
            "fields": {
              "item": [
                {
                  "title": "SKU",
                  "value": "={{ $json.sku }}",
                  "short": true
                },
                {
                  "title": "Product",
                  "value": "={{ $json.product_name }}",
                  "short": true
                },
                {
                  "title": "Current Stock",
                  "value": "={{ $json.new_quantity }}",
                  "short": true
                },
                {
                  "title": "Reorder Point",
                  "value": "={{ $json.product.reorder_point }}",
                  "short": true
                }
              ]
            }
          }
        ]
      },
      "id": "slack-stock-alert",
      "name": "Slack Stock Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1800, 460],
      "credentials": {
        "slackApi": {
          "id": "slack-creds",
          "name": "Slack API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, sku: $json.sku, new_quantity: $json.new_quantity }) }}",
        "options": {}
      },
      "id": "respond-update",
      "name": "Respond Update Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2020, 520]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.INVENTORY_API_URL }}/api/vendors/{{ $json.vendor_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INVENTORY_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-vendor",
      "name": "Fetch Vendor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 740]
    },
    {
      "parameters": {
        "jsCode": "const po = $input.first().json;\nconst vendor = po.vendor;\n\nlet totalValue = 0;\nconst lineItems = [];\n\nfor (const item of po.items) {\n  const lineTotal = item.quantity * item.unit_price;\n  totalValue += lineTotal;\n  \n  lineItems.push({\n    ...item,\n    line_total: lineTotal\n  });\n}\n\nreturn [{\n  json: {\n    po_number: po.po_number,\n    vendor: {\n      id: vendor.id,\n      name: vendor.name,\n      email: vendor.contact_email,\n      payment_terms: vendor.payment_terms\n    },\n    items: lineItems,\n    subtotal: totalValue,\n    tax: totalValue * 0.08, // 8% tax\n    total: totalValue * 1.08,\n    requested_by: po.requested_by,\n    status: 'pending_approval',\n    created_at: new Date().toISOString(),\n    expected_delivery: new Date(Date.now() + vendor.lead_time_days * 24 * 60 * 60 * 1000).toISOString().split('T')[0]\n  }\n}];"
      },
      "id": "process-po",
      "name": "Process Purchase Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 740]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INVENTORY_API_URL }}/api/purchase-orders",
        "sendHeaders": true,
        "headerParameters": {

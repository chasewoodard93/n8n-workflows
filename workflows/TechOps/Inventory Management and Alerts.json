    {
      "parameters": {
        "sendTo": "={{ $env.PURCHASING_MANAGER_EMAIL }}",
        "subject": "=PO Approval Required: {{ $json.po_number }} - ${{ $json.total.toFixed(2) }}",
        "emailType": "html",

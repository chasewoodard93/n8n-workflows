      "id": "fetch-inventory",
      "name": "Fetch All Inventory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "jsCode": "const products = $input.first().json.products || [];\n\nconst analysis = {\n  low_stock: [],\n  out_of_stock: [],\n  overstock: [],\n  reorder_needed: [],\n  healthy: [],\n  total_value: 0,\n  total_items: 0\n};\n\nfor (const product of products) {\n  const currentStock = product.quantity_on_hand || 0;\n  const reorderPoint = product.reorder_point || 10;\n  const reorderQty = product.reorder_quantity || 50;\n  const maxStock = product.max_stock || 200;\n  const unitCost = product.unit_cost || 0;\n  \n  analysis.total_value += currentStock * unitCost;\n  analysis.total_items += currentStock;\n  \n  const stockItem = {\n    sku: product.sku,\n    name: product.name,\n    current_stock: currentStock,\n    reorder_point: reorderPoint,\n    reorder_quantity: reorderQty,\n    unit_cost: unitCost,\n    location: product.location,\n    vendor_id: product.primary_vendor_id\n  };\n  \n  if (currentStock === 0) {\n    stockItem.urgency = 'critical';\n    analysis.out_of_stock.push(stockItem);\n    analysis.reorder_needed.push(stockItem);\n  } else if (currentStock <= reorderPoint) {\n    stockItem.urgency = 'high';\n    analysis.low_stock.push(stockItem);\n    analysis.reorder_needed.push(stockItem);\n  } else if (currentStock > maxStock) {\n    stockItem.urgency = 'low';\n    analysis.overstock.push(stockItem);\n  } else {\n    analysis.healthy.push(stockItem);\n  }\n}\n\n// Sort by urgency\nanalysis.reorder_needed.sort((a, b) => a.current_stock - b.current_stock);\n\nreturn [{ json: analysis }];"
      },
      "id": "analyze-inventory",
      "name": "Analyze Inventory Levels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "needs-reorder",
              "leftValue": "={{ $json.reorder_needed.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "check-reorder",
      "name": "Needs Reorder?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1360, 300]
    },
    {
      "parameters": {
        "jsCode": "const analysis = $input.first().json;\nconst reorderItems = analysis.reorder_needed;\n\n// Group by vendor for efficient ordering\nconst vendorOrders = {};\n\nfor (const item of reorderItems) {\n  const vendorId = item.vendor_id || 'default';\n  if (!vendorOrders[vendorId]) {\n    vendorOrders[vendorId] = {\n      vendor_id: vendorId,\n      items: [],\n      total_value: 0\n    };\n  }\n  \n  const orderQty = item.reorder_quantity;\n  const lineTotal = orderQty * item.unit_cost;\n  \n  vendorOrders[vendorId].items.push({\n    sku: item.sku,\n    name: item.name,\n    quantity: orderQty,\n    unit_cost: item.unit_cost,\n    line_total: lineTotal,\n    urgency: item.urgency\n  });\n  \n  vendorOrders[vendorId].total_value += lineTotal;\n}\n\nreturn Object.values(vendorOrders).map(order => ({ json: order }));"
      },
      "id": "prepare-orders",
      "name": "Prepare Vendor Orders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1580, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INVENTORY_API_URL }}/api/purchase-orders/draft",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INVENTORY_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"vendor_id\": \"{{ $json.vendor_id }}\",\n  \"items\": {{ JSON.stringify($json.items) }},\n  \"total_value\": {{ $json.total_value }},\n  \"status\": \"draft\",\n  \"auto_generated\": true,\n  \"created_at\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "create-draft-po",
      "name": "Create Draft PO",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1800, 200]
    },
    {
      "parameters": {
        "sendTo": "={{ $env.PURCHASING_EMAIL }}",
        "subject": "=Inventory Alert: {{ $json.out_of_stock.length }} Out of Stock, {{ $json.low_stock.length }} Low Stock",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 700px; margin: 0 auto;\">\n<h1>Daily Inventory Alert</h1>\n<p>The following items require attention:</p>\n\n{{ $json.out_of_stock.length > 0 ? `<h2 style=\"color: #d32f2f;\">Out of Stock (${$json.out_of_stock.length})</h2><table style=\"width: 100%; border-collapse: collapse; margin: 10px 0;\"><tr style=\"background: #ffebee;\"><th style=\"padding: 8px; border: 1px solid #ddd;\">SKU</th><th style=\"padding: 8px; border: 1px solid #ddd;\">Product</th><th style=\"padding: 8px; border: 1px solid #ddd;\">Location</th></tr>${$json.out_of_stock.map(item => '<tr><td style=\"padding: 8px; border: 1px solid #ddd;\">' + item.sku + '</td><td style=\"padding: 8px; border: 1px solid #ddd;\">' + item.name + '</td><td style=\"padding: 8px; border: 1px solid #ddd;\">' + item.location + '</td></tr>').join('')}</table>` : '' }}\n\n{{ $json.low_stock.length > 0 ? `<h2 style=\"color: #ff9800;\">Low Stock (${$json.low_stock.length})</h2><table style=\"width: 100%; border-collapse: collapse; margin: 10px 0;\"><tr style=\"background: #fff3e0;\"><th style=\"padding: 8px; border: 1px solid #ddd;\">SKU</th><th style=\"padding: 8px; border: 1px solid #ddd;\">Product</th><th style=\"padding: 8px; border: 1px solid #ddd;\">Current</th><th style=\"padding: 8px; border: 1px solid #ddd;\">Reorder Point</th></tr>${$json.low_stock.map(item => '<tr><td style=\"padding: 8px; border: 1px solid #ddd;\">' + item.sku + '</td><td style=\"padding: 8px; border: 1px solid #ddd;\">' + item.name + '</td><td style=\"padding: 8px; border: 1px solid #ddd;\">' + item.current_stock + '</td><td style=\"padding: 8px; border: 1px solid #ddd;\">' + item.reorder_point + '</td></tr>').join('')}</table>` : '' }}\n\n<h3>Summary</h3>\n<ul>\n<li>Total Inventory Value: ${{ $json.total_value.toLocaleString() }}</li>\n<li>Total Items: {{ $json.total_items.toLocaleString() }}</li>\n<li>Items Needing Reorder: {{ $json.reorder_needed.length }}</li>\n</ul>\n\n<p>Draft purchase orders have been created for review.</p>\n\n<p><a href=\"{{ $env.INVENTORY_PORTAL_URL }}/purchase-orders/pending\" style=\"background: #1976d2; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px;\">Review Purchase Orders</a></p>\n</div>",
        "options": {}
      },
      "id": "email-inventory-alert",
      "name": "Email Inventory Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1580, 360],
      "credentials": {
        "smtp": {

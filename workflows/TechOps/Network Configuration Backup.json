      "parameters": {
        "jsCode": "// Get device inventory from source of truth (NetBox, Nautobot, or static config)\nconst sourceOfTruth = $env.SOURCE_OF_TRUTH || 'static';\n\n// In production, this would query NetBox/Nautobot API\n// For now, using environment-based configuration\nconst devices = JSON.parse($env.NETWORK_DEVICES || '[]');\n\n// If no devices configured, use example structure\nconst inventory = devices.length > 0 ? devices : [\n  {\n    hostname: 'core-rtr-01',\n    ip: '192.168.1.1',\n    platform: 'cisco_ios',\n    type: 'router',\n    site: 'datacenter-1',\n    role: 'core'\n  },\n  {\n    hostname: 'dist-sw-01',\n    ip: '192.168.1.10',\n    platform: 'cisco_nxos',\n    type: 'switch',\n    site: 'datacenter-1',\n    role: 'distribution'\n  },\n  {\n    hostname: 'fw-01',\n    ip: '192.168.1.254',\n    platform: 'paloalto_panos',\n    type: 'firewall',\n    site: 'datacenter-1',\n    role: 'perimeter'\n  }\n];\n\nconst backupConfig = {\n  backupPath: $env.BACKUP_PATH || '/backups/network',\n  retentionDays: parseInt($env.BACKUP_RETENTION_DAYS || '90'),\n  gitRepo: $env.BACKUP_GIT_REPO || '',\n  compareWithPrevious: $env.COMPARE_BACKUPS !== 'false'\n};\n\nreturn {\n  json: {\n    devices: inventory,\n    backupConfig,\n    startTime: new Date().toISOString(),\n    sourceOfTruth\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 100],
      "id": "get-inventory",
      "name": "Get Device Inventory"

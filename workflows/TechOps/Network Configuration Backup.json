              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1760, 100],
      "id": "check-changes",
      "name": "Check for Changes"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-4-20250514"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a network configuration analyst. Analyze the following configuration change for device {{ $json.hostname }} ({{ $json.platform }}).\n\nThe configuration has changed since the last backup. Please:\n1. Identify what type of changes were made (security, routing, interface, ACL, etc.)\n2. Assess potential risk level (low, medium, high, critical)\n3. Flag any security concerns\n4. Note if this appears to be a planned or unexpected change\n\nDevice: {{ $json.hostname }}\nPlatform: {{ $json.platform }}\nSite: {{ $json.site }}\nRole: {{ $json.role }}\n\nProvide a concise analysis suitable for a change log."
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [1980, 0],
      "id": "ai-analyze",
      "name": "AI Analyze Changes",
      "credentials": {
        "anthropicApi": {
          "id": "anthropic-credentials",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Log the detected change\nconst data = $input.first().json;\n\nconst changeLog = {\n  id: `chg-${Date.now()}`,\n  hostname: data.hostname,\n  platform: data.platform,\n  site: data.site,\n  role: data.role,\n  detectedAt: data.changeDetectedAt,\n  previousHash: data.previousHash,\n  currentHash: data.configHash,\n  aiAnalysis: data.message?.content || data.analysis || 'Analysis pending',\n  requiresReview: true,\n  status: 'detected'\n};\n\n// This would be stored in a database in production\nreturn {\n  json: {\n    ...data,\n    changeLog\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, 0],
      "id": "log-change",
      "name": "Log Change Detection"
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [1980, 300],
      "id": "aggregate-results",
      "name": "Aggregate Results"
    },
    {
      "parameters": {
        "jsCode": "// Generate backup report\nconst items = $input.first().json.data || [];\n\nconst successCount = items.filter(i => i.success).length;\nconst failureCount = items.filter(i => !i.success).length;\nconst changeCount = items.filter(i => i.hasChanges).length;\n\nconst report = {\n  reportId: `backup-${Date.now()}`,\n  generatedAt: new Date().toISOString(),\n  summary: {\n    totalDevices: items.length,\n    successful: successCount,\n    failed: failureCount,\n    changesDetected: changeCount,\n    successRate: items.length > 0 ? ((successCount / items.length) * 100).toFixed(1) + '%' : '0%'\n  },\n  failures: items.filter(i => !i.success).map(i => ({\n    hostname: i.hostname,\n    ip: i.ip,\n    error: i.error\n  })),\n  changes: items.filter(i => i.hasChanges).map(i => ({\n    hostname: i.hostname,\n    site: i.site,\n    analysis: i.changeLog?.aiAnalysis || 'Pending'\n  })),\n  allDevices: items.map(i => ({\n    hostname: i.hostname,\n    success: i.success,\n    hasChanges: i.hasChanges,\n    backupTime: i.backupTime\n  }))\n};\n\nreturn {\n  json: report\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, 300],
      "id": "generate-report",
      "name": "Generate Backup Report"
    },

    {
      "parameters": {
        "jsCode": "// Process backup result from device\nconst input = $input.first().json;\n\nconst backupResult = {\n  hostname: input.hostname || 'unknown',\n  ip: input.ip || '',\n  platform: input.platform || '',\n  site: input.site || '',\n  role: input.role || '',\n  backupTime: new Date().toISOString(),\n  success: input.success !== false && !input.error,\n  config: input.config || input.output || '',\n  configHash: '', // Will be computed\n  error: input.error || null,\n  responseTime: input.responseTime || 0\n};\n\n// Compute hash of configuration for change detection\nif (backupResult.config) {\n  const crypto = require('crypto');\n  backupResult.configHash = crypto.createHash('sha256')\n    .update(backupResult.config)\n    .digest('hex');\n  backupResult.configSize = backupResult.config.length;\n}\n\nreturn {\n  json: backupResult\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 100],
      "id": "process-result",
      "name": "Process Backup Result"
    },
    {
      "parameters": {
        "jsCode": "// Compare current backup with previous version\nconst current = $input.first().json;\n\n// In production, this would query a database or file system\n// for the previous backup hash\nconst previousHash = $env[`LAST_HASH_${current.hostname.replace(/-/g, '_').toUpperCase()}`] || '';\n\nconst comparison = {\n  ...current,\n  hasChanges: previousHash !== '' && previousHash !== current.configHash,\n  previousHash: previousHash,\n  isFirstBackup: previousHash === '',\n  changeDetectedAt: previousHash !== current.configHash ? new Date().toISOString() : null\n};\n\nreturn {\n  json: comparison\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 100],
      "id": "compare-previous",
      "name": "Compare with Previous"
    },
    {

      "parameters": {
        "sendTo": "={{ $env.ONCALL_EMAIL }}",
        "subject": "=🚨 CRITICAL: {{ $json.host }} - {{ $json.service }} Alert",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<h2 style=\"color: #d32f2f;\">Critical System Alert</h2>\n\n<div style=\"background: #ffebee; padding: 15px; border-radius: 4px; margin: 20px 0;\">\n<p><strong>Alert ID:</strong> {{ $json.alert_id }}</p>\n<p><strong>Host:</strong> {{ $json.host }}</p>\n<p><strong>Service:</strong> {{ $json.service }}</p>\n<p><strong>Severity:</strong> {{ $json.severity.toUpperCase() }}</p>\n<p><strong>Time:</strong> {{ new Date().toISOString() }}</p>\n</div>\n\n<h3>Details</h3>\n<p><strong>Metric:</strong> {{ $json.metric_name }}</p>\n<p><strong>Current Value:</strong> {{ $json.metric_value }}</p>\n<p><strong>Threshold:</strong> {{ $json.threshold }}</p>\n<p><strong>Message:</strong> {{ $json.message }}</p>\n\n<p style=\"margin: 20px 0;\"><a href=\"{{ $env.MONITORING_DASHBOARD_URL }}/alerts/{{ $json.alert_id }}\" style=\"background: #d32f2f; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px;\">View Alert</a></p>\n</div>",

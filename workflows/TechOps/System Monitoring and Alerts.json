      "id": "fetch-services",
      "name": "Fetch Services",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 520]
    },
    {
      "parameters": {
        "jsCode": "const services = $input.first().json.services || [];\nconst results = [];\n\nfor (const service of services) {\n  results.push({\n    json: {\n      service_id: service.id,\n      service_name: service.name,\n      health_endpoint: service.health_endpoint,\n      expected_status: service.expected_status || 200,\n      timeout_ms: service.timeout_ms || 5000\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "prepare-checks",
      "name": "Prepare Health Checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 520]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.health_endpoint }}",
        "options": {
          "timeout": "={{ $json.timeout_ms }}"
        }
      },
      "id": "perform-health-check",
      "name": "Perform Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 520],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = {\n  healthy: [],\n  unhealthy: [],\n  degraded: [],\n  timestamp: new Date().toISOString()\n};\n\nfor (const item of items) {\n  const service = {\n    name: item.json.service_name,\n    endpoint: item.json.health_endpoint,\n    response_time: item.json.response_time_ms,\n    status_code: item.json.statusCode\n  };\n  \n  if (item.json.error) {\n    service.status = 'unhealthy';\n    service.error = item.json.error;\n    results.unhealthy.push(service);\n  } else if (item.json.statusCode === item.json.expected_status) {\n    if (item.json.response_time_ms > 2000) {\n      service.status = 'degraded';\n      results.degraded.push(service);\n    } else {\n      service.status = 'healthy';\n      results.healthy.push(service);\n    }\n  } else {\n    service.status = 'unhealthy';\n    results.unhealthy.push(service);\n  }\n}\n\nresults.summary = {\n  total: items.length,\n  healthy: results.healthy.length,\n  unhealthy: results.unhealthy.length,\n  degraded: results.degraded.length,\n  health_percentage: Math.round((results.healthy.length / items.length) * 100)\n};\n\nreturn [{ json: results }];"
      },
      "id": "aggregate-results",
      "name": "Aggregate Health Results",
      "type": "n8n-nodes-base.code",

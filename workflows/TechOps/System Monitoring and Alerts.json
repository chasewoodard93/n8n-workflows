    {
      "parameters": {
        "jsCode": "const alert = $input.first().json;\n\n// Determine alert priority and routing\nconst severityConfig = {\n  critical: { priority: 1, notify: ['pagerduty', 'slack', 'email'], escalate_minutes: 5 },\n  high: { priority: 2, notify: ['slack', 'email'], escalate_minutes: 15 },\n  medium: { priority: 3, notify: ['slack'], escalate_minutes: 60 },\n  low: { priority: 4, notify: ['slack'], escalate_minutes: 240 }\n};\n\nconst config = severityConfig[alert.severity] || severityConfig.medium;\n\n// Check for alert deduplication (same alert within 5 minutes)\nconst alertKey = `${alert.host}_${alert.service}_${alert.metric_name}`;\n\nreturn [{\n  json: {\n    ...alert,\n    alert_key: alertKey,\n    priority: config.priority,\n    notification_channels: config.notify,\n    escalate_after_minutes: config.escalate_minutes,\n    status: 'active',\n    created_at: new Date().toISOString(),\n    escalation_deadline: new Date(Date.now() + config.escalate_minutes * 60 * 1000).toISOString()\n  }\n}];"
      },

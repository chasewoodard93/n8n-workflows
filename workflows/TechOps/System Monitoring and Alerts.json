      "id": "merge-report-data",
      "name": "Merge Report Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1140, 800]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst metrics = items[0]?.json || {};\nconst alerts = items[1]?.json || {};\n\nconst report = {\n  report_date: new Date().toISOString().split('T')[0],\n  infrastructure: {\n    uptime_percentage: metrics.uptime_percentage || 99.9,\n    total_hosts: metrics.total_hosts || 0,\n    healthy_hosts: metrics.healthy_hosts || 0,\n    average_cpu: metrics.average_cpu || 0,\n    average_memory: metrics.average_memory || 0,\n    average_disk: metrics.average_disk || 0\n  },\n  alerts: {\n    total_24h: alerts.total || 0,\n    critical: alerts.by_severity?.critical || 0,\n    high: alerts.by_severity?.high || 0,\n    medium: alerts.by_severity?.medium || 0,\n    low: alerts.by_severity?.low || 0,\n    resolved: alerts.resolved || 0,\n    mttr_minutes: alerts.mttr_minutes || 0\n  },\n  top_issues: alerts.top_issues || [],\n  recommendations: []\n};\n\n// Generate recommendations based on metrics\nif (report.infrastructure.average_cpu > 80) {\n  report.recommendations.push('CPU utilization is high. Consider scaling or optimization.');\n}\nif (report.infrastructure.average_memory > 85) {\n  report.recommendations.push('Memory usage is elevated. Review application memory consumption.');\n}\nif (report.infrastructure.average_disk > 80) {\n  report.recommendations.push('Disk usage is high. Plan for capacity expansion.');\n}\nif (report.alerts.critical > 0) {\n  report.recommendations.push(`${report.alerts.critical} critical alerts occurred. Review root causes.`);\n}\n\nreturn [{ json: report }];"
      },
      "id": "compile-report",
      "name": "Compile Daily Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, 800]
    },
    {
      "parameters": {
        "sendTo": "={{ $env.IT_TEAM_EMAIL }}",
        "subject": "=Daily Infrastructure Report - {{ $json.report_date }}",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 700px; margin: 0 auto;\">\n<h1>Daily Infrastructure Report</h1>\n<p><strong>Date:</strong> {{ $json.report_date }}</p>\n\n<h2>Infrastructure Health</h2>\n<table style=\"width: 100%; border-collapse: collapse; margin: 20px 0;\">\n<tr style=\"background: #f5f5f5;\">\n<td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Uptime</strong></td>\n<td style=\"padding: 10px; border: 1px solid #ddd;\">{{ $json.infrastructure.uptime_percentage }}%</td>\n<td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Hosts</strong></td>\n<td style=\"padding: 10px; border: 1px solid #ddd;\">{{ $json.infrastructure.healthy_hosts }}/{{ $json.infrastructure.total_hosts }}</td>\n</tr>\n<tr>\n<td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Avg CPU</strong></td>\n<td style=\"padding: 10px; border: 1px solid #ddd; color: {{ $json.infrastructure.average_cpu > 80 ? '#d32f2f' : '#4caf50' }};\">{{ $json.infrastructure.average_cpu }}%</td>\n<td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Avg Memory</strong></td>\n<td style=\"padding: 10px; border: 1px solid #ddd; color: {{ $json.infrastructure.average_memory > 85 ? '#d32f2f' : '#4caf50' }};\">{{ $json.infrastructure.average_memory }}%</td>\n</tr>\n<tr style=\"background: #f5f5f5;\">\n<td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Avg Disk</strong></td>\n<td style=\"padding: 10px; border: 1px solid #ddd; color: {{ $json.infrastructure.average_disk > 80 ? '#d32f2f' : '#4caf50' }};\">{{ $json.infrastructure.average_disk }}%</td>\n<td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>MTTR</strong></td>\n<td style=\"padding: 10px; border: 1px solid #ddd;\">{{ $json.alerts.mttr_minutes }} min</td>\n</tr>\n</table>\n\n<h2>Alert Summary (24h)</h2>\n<table style=\"width: 100%; border-collapse: collapse; margin: 20px 0;\">\n<tr style=\"background: #f5f5f5;\">\n<th style=\"padding: 10px; border: 1px solid #ddd;\">Total</th>\n<th style=\"padding: 10px; border: 1px solid #ddd;\">Critical</th>\n<th style=\"padding: 10px; border: 1px solid #ddd;\">High</th>\n<th style=\"padding: 10px; border: 1px solid #ddd;\">Medium</th>\n<th style=\"padding: 10px; border: 1px solid #ddd;\">Low</th>\n<th style=\"padding: 10px; border: 1px solid #ddd;\">Resolved</th>\n</tr>\n<tr>\n<td style=\"padding: 10px; border: 1px solid #ddd; text-align: center;\">{{ $json.alerts.total_24h }}</td>\n<td style=\"padding: 10px; border: 1px solid #ddd; text-align: center; color: #d32f2f;\">{{ $json.alerts.critical }}</td>\n<td style=\"padding: 10px; border: 1px solid #ddd; text-align: center; color: #ff9800;\">{{ $json.alerts.high }}</td>\n<td style=\"padding: 10px; border: 1px solid #ddd; text-align: center;\">{{ $json.alerts.medium }}</td>\n<td style=\"padding: 10px; border: 1px solid #ddd; text-align: center;\">{{ $json.alerts.low }}</td>\n<td style=\"padding: 10px; border: 1px solid #ddd; text-align: center; color: #4caf50;\">{{ $json.alerts.resolved }}</td>\n</tr>\n</table>\n\n{{ $json.recommendations.length > 0 ? `<h2>Recommendations</h2><ul>${$json.recommendations.map(r => '<li>' + r + '</li>').join('')}</ul>` : '' }}\n\n<p><a href=\"{{ $env.MONITORING_DASHBOARD_URL }}\" style=\"background: #1976d2; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px;\">View Dashboard</a></p>\n</div>",
        "options": {}
      },

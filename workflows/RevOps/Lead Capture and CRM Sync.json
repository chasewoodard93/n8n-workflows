    {
      "parameters": {
        "jsCode": "// Parse lead data from email inquiry\nconst email = $input.first().json;\n\n// Extract potential lead info from email\nconst fromAddress = email.from?.value?.[0]?.address || email.from || '';\nconst fromName = email.from?.value?.[0]?.name || '';\nconst subject = email.subject || '';\nconst body = email.text || email.snippet || '';\n\n// Try to parse name\nlet firstName = '';\nlet lastName = '';\nif (fromName) {\n  const nameParts = fromName.trim().split(' ');\n  firstName = nameParts[0] || '';\n  lastName = nameParts.slice(1).join(' ') || '';\n}\n\n// Extract company from email domain\nconst emailDomain = fromAddress.split('@')[1] || '';\nconst company = emailDomain.split('.')[0] || '';\n\nreturn {\n  json: {\n    firstName,\n    lastName,\n    email: fromAddress,\n    company: company.charAt(0).toUpperCase() + company.slice(1),\n    phone: '',\n    jobTitle: '',\n    source: 'Email Inquiry',\n    message: `Subject: ${subject}\\n\\n${body}`,\n    targetCRM: 'HubSpot', // Default CRM for email leads\n    rawEmail: email\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [20, 400],
      "id": "parse-email-lead",
      "name": "Parse Email Lead"
    },
    {
      "parameters": {
        "jsCode": "// Normalize lead data from various sources into consistent format\nconst input = $input.first().json;\n\n// Map different field names to standard format\nconst normalizedLead = {\n  firstName: input.firstName || input['First Name'] || input.first_name || input.fname || '',\n  lastName: input.lastName || input['Last Name'] || input.last_name || input.lname || '',\n  email: (input.email || input.Email || input.email_address || '').toLowerCase().trim(),\n  phone: input.phone || input.Phone || input.phone_number || input.telephone || '',\n  company: input.company || input.Company || input.company_name || input.organization || '',\n  jobTitle: input.jobTitle || input['Job Title'] || input.job_title || input.title || input.position || '',\n  industry: input.industry || input.Industry || '',\n  companySize: input.companySize || input['Company Size'] || input.company_size || input.employees || '',\n  source: input.source || input['Lead Source'] || input.lead_source || input.utm_source || 'Unknown',\n  message: input.message || input.Message || input['Message/Interest'] || input.notes || input.Notes || '',\n  targetCRM: input.targetCRM || input['Target CRM'] || 'HubSpot',\n  \n  // Metadata\n  capturedAt: new Date().toISOString(),\n  ipAddress: input.ip || input.ip_address || '',\n  userAgent: input.userAgent || input.user_agent || '',\n  pageUrl: input.pageUrl || input.page_url || input.referrer || '',\n  utmCampaign: input.utm_campaign || '',\n  utmMedium: input.utm_medium || '',\n  utmContent: input.utm_content || ''\n};\n\n// Clean phone number\nif (normalizedLead.phone) {\n  normalizedLead.phone = normalizedLead.phone.replace(/[^0-9+\\-()\\s]/g, '');\n}\n\n// Create full name\nnormalizedLead.fullName = `${normalizedLead.firstName} ${normalizedLead.lastName}`.trim();\n\nreturn {\n  json: normalizedLead\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 100],
      "id": "normalize-lead",
      "name": "Normalize Lead Data"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-email",
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            },
            {
              "id": "valid-email",
              "leftValue": "={{ $json.email }}",
              "rightValue": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "has-name",
              "leftValue": "={{ $json.firstName || $json.lastName }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 100],
      "id": "validate-lead",
      "name": "Validate Lead"
    },
    {
      "parameters": {
        "jsCode": "// Enrich lead data with additional information\nconst lead = $input.first().json;\n\n// Extract domain from email for company enrichment\nconst emailDomain = lead.email.split('@')[1] || '';\n\n// Check if it's a personal email domain\nconst personalDomains = ['gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'aol.com', 'icloud.com', 'mail.com', 'protonmail.com'];\nconst isPersonalEmail = personalDomains.includes(emailDomain.toLowerCase());\n\n// Determine lead type\nlet leadType = 'B2C';\nif (!isPersonalEmail && lead.company) {\n  leadType = 'B2B';\n} else if (!isPersonalEmail) {\n  // Use domain as company name if not provided\n  lead.company = lead.company || emailDomain.split('.')[0].charAt(0).toUpperCase() + emailDomain.split('.')[0].slice(1);\n  leadType = 'B2B';\n}\n\n// Estimate company size category if not provided\nlet companySizeCategory = lead.companySize || 'Unknown';\nif (companySizeCategory === 'Unknown' && leadType === 'B2B') {\n  companySizeCategory = 'To Be Determined';\n}\n\n// Determine region from email domain TLD\nconst tld = emailDomain.split('.').pop()?.toLowerCase() || '';\nlet region = 'Unknown';\nconst regionMap = {\n  'com': 'Global/US',\n  'us': 'United States',\n  'uk': 'United Kingdom',\n  'co.uk': 'United Kingdom',\n  'de': 'Germany',\n  'fr': 'France',\n  'au': 'Australia',\n  'ca': 'Canada',\n  'jp': 'Japan',\n  'in': 'India'\n};\nregion = regionMap[tld] || 'International';\n\nconst enrichedLead = {\n  ...lead,\n  emailDomain,\n  isPersonalEmail,\n  leadType,\n  companySizeCategory,\n  region,\n  enrichedAt: new Date().toISOString()\n};\n\nreturn {\n  json: enrichedLead\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 0],
      "id": "enrich-lead",
      "name": "Enrich Lead Data"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this sales lead and provide a score and insights:\n\n**Lead Information:**\n- Name: {{ $json.fullName }}\n- Email: {{ $json.email }}\n- Company: {{ $json.company || 'Not provided' }}\n- Job Title: {{ $json.jobTitle || 'Not provided' }}\n- Industry: {{ $json.industry || 'Not provided' }}\n- Company Size: {{ $json.companySizeCategory || 'Unknown' }}\n- Lead Source: {{ $json.source }}\n- Lead Type: {{ $json.leadType }}\n- Message/Interest: {{ $json.message || 'None provided' }}\n\n**Please provide:**\n1. Lead Score (1-100): Based on likelihood to convert\n2. Lead Quality: Hot, Warm, or Cold\n3. Recommended Priority: High, Medium, or Low\n4. Key Insights: 2-3 bullet points about this lead\n5. Suggested Next Action: What should sales do first?\n6. Potential Value: Estimated deal size category (Small: <$10k, Medium: $10k-50k, Large: $50k-250k, Enterprise: >$250k)\n\nRespond in this exact JSON format:\n```json\n{\n  \"score\": 75,\n  \"quality\": \"Warm\",\n  \"priority\": \"Medium\",\n  \"insights\": [\"insight 1\", \"insight 2\"],\n  \"nextAction\": \"suggested action\",\n  \"potentialValue\": \"Medium\"\n}\n```",
        "options": {
          "systemMessage": "You are a sales lead scoring AI assistant. Analyze leads objectively based on the information provided. Consider factors like: company size, job title seniority, industry fit, lead source quality, and expressed interest. Be realistic with scores - most leads should score between 30-70. Only score above 80 for exceptionally qualified leads with clear buying signals."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [900, 0],
      "id": "ai-lead-scoring",
      "name": "AI Lead Scoring"
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "options": {
          "temperature": 0.3,
          "maxTokensToSample": 1024
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.2,
      "position": [920, 220],
      "id": "anthropic-claude",
      "name": "Anthropic Claude",
      "credentials": {
        "anthropicApi": {
          "id": "anthropic-credentials",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse AI response and merge with lead data\nconst lead = $input.first().json;\n\n// Try to extract JSON from AI response\nlet aiAnalysis = {\n  score: 50,\n  quality: 'Warm',\n  priority: 'Medium',\n  insights: [],\n  nextAction: 'Follow up via email',\n  potentialValue: 'Medium'\n};\n\ntry {\n  // The AI response might be in different formats\n  const aiOutput = lead.output || lead.text || lead.response || '';\n  \n  // Try to find JSON in the response\n  const jsonMatch = aiOutput.match(/```json\\n?([\\s\\S]*?)\\n?```/) || aiOutput.match(/\\{[\\s\\S]*\\}/);\n  \n  if (jsonMatch) {\n    const jsonStr = jsonMatch[1] || jsonMatch[0];\n    aiAnalysis = JSON.parse(jsonStr);\n  }\n} catch (e) {\n  // Use defaults if parsing fails\n  console.log('AI response parsing failed, using defaults');\n}\n\n// Merge AI analysis with lead data\nconst scoredLead = {\n  ...lead,\n  leadScore: aiAnalysis.score || 50,\n  leadQuality: aiAnalysis.quality || 'Warm',\n  priority: aiAnalysis.priority || 'Medium',\n  aiInsights: aiAnalysis.insights || [],\n  suggestedNextAction: aiAnalysis.nextAction || 'Follow up via email',\n  potentialValue: aiAnalysis.potentialValue || 'Medium',\n  scoredAt: new Date().toISOString()\n};\n\n// Determine if this is a high-priority lead\nscoredLead.isHighPriority = scoredLead.leadScore >= 70 || scoredLead.priority === 'High';\n\nreturn {\n  json: scoredLead\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 0],
      "id": "parse-ai-response",
      "name": "Check Duplicate"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.targetCRM }}",
                    "rightValue": "Salesforce",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Salesforce"

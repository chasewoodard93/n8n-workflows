    {
      "parameters": {
        "jsCode": "// Calculate customer health score\nconst customers = $input.first().json.customers || $input.first().json || [];\n\nconst calculateHealthScore = (customer) => {\n  let score = 0;\n  const factors = [];\n  \n  // Usage score (0-25)\n  const usageRate = customer.usageRate || 0;\n  if (usageRate >= 80) { score += 25; factors.push('High usage'); }\n  else if (usageRate >= 50) { score += 15; factors.push('Moderate usage'); }\n  else if (usageRate >= 20) { score += 5; factors.push('Low usage'); }\n  else { factors.push('Very low usage - risk'); }\n  \n  // Support tickets (0-20)\n  const openTickets = customer.openTickets || 0;\n  const ticketSentiment = customer.avgTicketSentiment || 0;\n  if (openTickets === 0 && ticketSentiment >= 4) { score += 20; factors.push('No issues'); }\n  else if (openTickets <= 2) { score += 15; factors.push('Few tickets'); }\n  else if (openTickets <= 5) { score += 5; factors.push('Multiple open tickets'); }\n  else { factors.push('High ticket volume - risk'); }\n  \n  // NPS Score (0-20)\n  const nps = customer.npsScore || 0;\n  if (nps >= 9) { score += 20; factors.push('Promoter'); }\n  else if (nps >= 7) { score += 10; factors.push('Passive'); }\n  else if (nps > 0) { factors.push('Detractor - risk'); }\n  \n  // Engagement (0-20)\n  const lastLogin = customer.lastLoginDays || 999;\n  if (lastLogin <= 7) { score += 20; factors.push('Active engagement'); }\n  else if (lastLogin <= 14) { score += 15; factors.push('Recent engagement'); }\n  else if (lastLogin <= 30) { score += 5; factors.push('Declining engagement'); }\n  else { factors.push('No recent engagement - risk'); }\n  \n  // Contract value growth (0-15)\n  const growth = customer.contractGrowth || 0;\n  if (growth > 0) { score += 15; factors.push('Account growing'); }\n  else if (growth === 0) { score += 10; factors.push('Stable account'); }\n  else { factors.push('Account shrinking - risk'); }\n  \n  return {\n    ...customer,\n    healthScore: score,\n    healthStatus: score >= 80 ? 'healthy' : score >= 50 ? 'needs_attention' : 'at_risk',\n    healthFactors: factors\n  };\n};\n\nconst analyzed = (Array.isArray(customers) ? customers : [customers]).map(calculateHealthScore);\n\nreturn analyzed.map(c => ({ json: c }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0],

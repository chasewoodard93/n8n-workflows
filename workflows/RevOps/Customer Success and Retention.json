    {
      "parameters": {
        "jsCode": "// Process usage event and check patterns\nconst event = $input.first().json;\n\nconst usageData = {\n  customerId: event.customerId,\n  eventType: event.type,\n  timestamp: new Date().toISOString(),\n  \n  // Check patterns\n  isFirstLogin: event.type === 'login' && event.isFirst,\n  isMilestone: event.type === 'milestone',\n  milestoneType: event.milestone || null,\n  \n  // Usage metrics\n  currentUsage: event.usage || 0,\n  previousUsage: event.previousUsage || 0,\n  usageChange: ((event.usage || 0) - (event.previousUsage || 0)) / (event.previousUsage || 1) * 100,\n  \n  // Flags\n  isLowUsage: (event.usage || 0) < 20,\n  isHighUsage: (event.usage || 0) > 80,\n  isDecreasing: event.usage < event.previousUsage * 0.7\n};\n\nreturn {\n  json: usageData\n};"
      },
      "type": "n8n-nodes-base.code",

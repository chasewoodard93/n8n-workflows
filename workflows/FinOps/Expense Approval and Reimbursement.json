      "parameters": {
        "jsCode": "const expense = $input.first().json;\n\n// Generate expense ID\nconst expenseId = `EXP-${Date.now()}`;\n\n// Determine approval chain based on amount and department\nlet approvalLevel = 'manager';\nlet approvers = [];\n\nif (expense.amount > 5000) {\n  approvalLevel = 'director';\n} else if (expense.amount > 1000) {\n  approvalLevel = 'manager';\n} else {\n  approvalLevel = 'auto_approve';\n}\n\n// Expense categories that require additional review\nconst sensitiveCategories = ['travel', 'entertainment', 'gifts', 'conference'];\nconst requiresFinanceReview = sensitiveCategories.includes(expense.expense_type.toLowerCase()) || expense.amount > 2500;\n\nreturn [{\n  json: {\n    expense_id: expenseId,\n    ...expense,\n    submitted_at: new Date().toISOString(),\n    status: approvalLevel === 'auto_approve' ? 'approved' : 'pending_approval',\n    approval_level: approvalLevel,\n    requires_finance_review: requiresFinanceReview,\n    approval_chain: [],\n    current_approver_level: 0\n  }\n}];"
      },

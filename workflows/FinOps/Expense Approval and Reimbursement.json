    {
      "parameters": {
        "jsCode": "const expense = $input.first().json;\nconst approval = $input.first().json;\n\nconst decision = approval.decision; // 'approved' or 'rejected'\nconst comments = approval.comments;\nconst approverId = approval.approver_id;\n\n// Update approval chain\nconst approvalEntry = {\n  approver_id: approverId,\n  decision: decision,\n  comments: comments,\n  timestamp: new Date().toISOString()\n};\n\nexpense.approval_chain = expense.approval_chain || [];\nexpense.approval_chain.push(approvalEntry);\n\n// Determine next status\nif (decision === 'rejected') {\n  expense.status = 'rejected';\n} else if (expense.requires_finance_review && !expense.finance_approved) {\n  expense.status = 'pending_finance_review';\n} else {\n  expense.status = 'approved';\n}\n\nreturn [{ json: expense }];"
      },

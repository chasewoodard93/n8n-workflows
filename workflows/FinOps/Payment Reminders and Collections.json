      "parameters": {
        "sendTo": "={{ $json.customer_email }}",
        "subject": "={{ $json.email_subject }}",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n{{ $json.email_body }}\n\n<div style=\"margin: 20px 0; padding: 15px; background: {{ $json.urgency === 'critical' ? '#ffebee' : $json.urgency === 'urgent' ? '#fff3e0' : '#e3f2fd' }}; border-radius: 4px;\">\n<p><strong>Invoice:</strong> {{ $json.invoice_number }}</p>\n<p><strong>Amount Due:</strong> {{ $json.currency }} {{ $json.amount_due.toFixed(2) }}</p>\n<p><strong>Days Overdue:</strong> {{ $json.days_overdue }}</p>\n</div>\n\n<p style=\"margin: 20px 0;\">\n<a href=\"{{ $env.PAYMENT_PORTAL_URL }}/pay/{{ $json.invoice_id }}\" style=\"background: {{ $json.urgency === 'critical' ? '#d32f2f' : $json.urgency === 'urgent' ? '#f57c00' : '#1976d2' }}; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px;\">Pay Now</a>\n</p>\n\n<p style=\"font-size: 12px; color: #666;\">If you have already made this payment, please disregard this notice. For payment arrangements, contact us at {{ $env.COLLECTIONS_EMAIL }} or {{ $env.COLLECTIONS_PHONE }}.</p>\n</div>",
        "options": {}
      },

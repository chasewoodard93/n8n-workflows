    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet aiContent;\n\ntry {\n  aiContent = JSON.parse(item.text || item.response);\n} catch (e) {\n  // Fallback if JSON parsing fails\n  aiContent = {\n    subject: `Payment Reminder: Invoice ${item.invoice_number} - ${item.currency} ${item.amount_due} Overdue`,\n    body: item.text || item.response\n  };\n}\n\nreturn [{\n  json: {\n    ...item,\n    email_subject: aiContent.subject,\n    email_body: aiContent.body\n  }\n}];"
      },
      "id": "parse-ai-response",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 200]

    {
      "parameters": {
        "jsCode": "const invoices = $input.first().json.invoices || [];\nconst today = new Date();\n\nconst categorized = {\n  reminder_1: [],      // 1-7 days overdue\n  reminder_2: [],      // 8-14 days overdue\n  reminder_3: [],      // 15-30 days overdue\n  collections_soft: [], // 31-60 days overdue\n  collections_hard: [], // 61-90 days overdue\n  external_collections: [], // 90+ days overdue\n  total_overdue: 0,\n  accounts_at_risk: 0\n};\n\nfor (const inv of invoices) {\n  const dueDate = new Date(inv.due_date);\n  const daysOverdue = Math.ceil((today - dueDate) / (1000 * 60 * 60 * 24));\n  \n  inv.days_overdue = daysOverdue;\n  categorized.total_overdue += inv.amount_due;\n  \n  // Check if there's an active payment promise\n  if (inv.payment_promise && new Date(inv.payment_promise.date) > today) {\n    inv.has_active_promise = true;\n    continue; // Skip reminder if promise is active\n  }\n  \n  if (daysOverdue <= 7) {\n    categorized.reminder_1.push(inv);\n  } else if (daysOverdue <= 14) {\n    categorized.reminder_2.push(inv);\n  } else if (daysOverdue <= 30) {\n    categorized.reminder_3.push(inv);\n  } else if (daysOverdue <= 60) {\n    categorized.collections_soft.push(inv);\n    categorized.accounts_at_risk++;\n  } else if (daysOverdue <= 90) {\n    categorized.collections_hard.push(inv);\n    categorized.accounts_at_risk++;\n  } else {\n    categorized.external_collections.push(inv);\n    categorized.accounts_at_risk++;\n  }\n}\n\nreturn [{ json: categorized }];"
      },
      "id": "categorize-overdue",
      "name": "Categorize by Aging",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },

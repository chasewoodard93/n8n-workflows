    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst allReminders = [];\n\n// Process each category with appropriate template\nconst categories = [\n  { key: 'reminder_1', template: 'friendly_reminder', urgency: 'low' },\n  { key: 'reminder_2', template: 'second_reminder', urgency: 'medium' },\n  { key: 'reminder_3', template: 'final_reminder', urgency: 'high' },\n  { key: 'collections_soft', template: 'collections_notice', urgency: 'urgent' },\n  { key: 'collections_hard', template: 'final_notice', urgency: 'critical' }\n];\n\nfor (const cat of categories) {\n  for (const inv of data[cat.key]) {\n    allReminders.push({\n      json: {\n        ...inv,\n        template: cat.template,\n        urgency: cat.urgency,\n        category: cat.key\n      }\n    });\n  }\n}\n\nreturn allReminders;"
      },
      "id": "prepare-reminders",
      "name": "Prepare All Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Generate a payment reminder email based on the urgency level and template type.\n\nInvoice Details:\n- Invoice Number: {{ $json.invoice_number }}\n- Customer: {{ $json.customer_name }}\n- Amount Due: {{ $json.currency }} {{ $json.amount_due }}\n- Original Due Date: {{ $json.due_date }}\n- Days Overdue: {{ $json.days_overdue }}\n- Template Type: {{ $json.template }}\n- Urgency: {{ $json.urgency }}\n\nTemplate Guidelines:\n- friendly_reminder (1-7 days): Polite, assume oversight, offer help\n- second_reminder (8-14 days): Firmer tone, request action, mention importance\n- final_reminder (15-30 days): Urgent, warn of consequences, request immediate contact\n- collections_notice (31-60 days): Formal, mention potential service impact, offer payment plan\n- final_notice (61-90 days): Legal tone, final warning before external collections\n\nGenerate:\n1. Subject line appropriate to urgency\n2. Email body with appropriate tone\n3. Clear call to action\n4. Payment link reference\n5. Contact information for payment arrangements\n\nReturn as JSON with 'subject' and 'body' fields.",
        "options": {
          "systemMessage": "You are a professional collections specialist. Write effective collection communications that maintain customer relationships while ensuring payment recovery. Adjust tone based on urgency level."
        }
      },

    {
      "parameters": {
        "jsCode": "// Generate AR aging summary\nconst data = $input.first().json;\n\nconst summary = {\n  report_date: new Date().toISOString().split('T')[0],\n  total_outstanding: data.total_outstanding,\n  total_overdue: data.total_overdue,\n  overdue_count: data.overdue.length,\n  due_soon_count: data.due_soon.length,\n  current_count: data.current.length,\n  aging_buckets: {\n    current: data.current.reduce((sum, inv) => sum + inv.amount_due, 0),\n    due_1_7_days: data.due_soon.reduce((sum, inv) => sum + inv.amount_due, 0),\n    overdue_1_30: data.overdue.filter(inv => inv.days_overdue <= 30).reduce((sum, inv) => sum + inv.amount_due, 0),\n    overdue_31_60: data.overdue.filter(inv => inv.days_overdue > 30 && inv.days_overdue <= 60).reduce((sum, inv) => sum + inv.amount_due, 0),\n    overdue_61_90: data.overdue.filter(inv => inv.days_overdue > 60 && inv.days_overdue <= 90).reduce((sum, inv) => sum + inv.amount_due, 0),\n    overdue_90_plus: data.overdue.filter(inv => inv.days_overdue > 90).reduce((sum, inv) => sum + inv.amount_due, 0)\n  },\n  high_risk_accounts: data.overdue.filter(inv => inv.days_overdue > 60).map(inv => ({\n    customer: inv.customer_name,\n    invoice: inv.invoice_number,\n    amount: inv.amount_due,\n    days_overdue: inv.days_overdue\n  }))\n};\n\nreturn [{ json: summary }];"
      },
      "id": "generate-ar-summary",
      "name": "Generate AR Aging Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

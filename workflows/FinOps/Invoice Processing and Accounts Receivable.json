    {
      "parameters": {
        "jsCode": "const invoice = $input.first().json;\nconst customer = invoice.customer;\n\n// Generate invoice number if not present\nconst invoiceNumber = invoice.invoice_number || `INV-${Date.now()}`;\n\n// Calculate tax and totals\nconst subtotal = invoice.line_items.reduce((sum, item) => sum + (item.quantity * item.unit_price), 0);\nconst taxRate = invoice.tax_rate || 0;\nconst taxAmount = subtotal * (taxRate / 100);\nconst total = subtotal + taxAmount;\n\nreturn [{\n  json: {\n    invoice_number: invoiceNumber,\n    invoice_id: invoice.invoice_id,\n    customer: {\n      id: customer.id,\n      name: customer.name,\n      email: customer.email,\n      billing_address: customer.billing_address,\n      payment_terms: customer.payment_terms || 'Net 30'\n    },\n    line_items: invoice.line_items,\n    subtotal: subtotal,\n    tax_rate: taxRate,\n    tax_amount: taxAmount,\n    total: total,\n    currency: invoice.currency || 'USD',\n    due_date: invoice.due_date,\n    issue_date: new Date().toISOString().split('T')[0],\n    status: 'pending',\n    notes: invoice.notes || ''\n  }\n}];"
      },
      "id": "process-invoice",
      "name": "Process Invoice Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 300]
    },
    {
      "parameters": {
        "jsCode": "const invoices = $input.first().json.invoices || [];\nconst today = new Date();\nconst results = {\n  overdue: [],\n  due_soon: [],\n  current: [],\n  total_outstanding: 0,\n  total_overdue: 0\n};\n\nfor (const inv of invoices) {\n  const dueDate = new Date(inv.due_date);\n  const daysUntilDue = Math.ceil((dueDate - today) / (1000 * 60 * 60 * 24));\n  \n  results.total_outstanding += inv.amount_due;\n  \n  if (daysUntilDue < 0) {\n    inv.days_overdue = Math.abs(daysUntilDue);\n    results.overdue.push(inv);\n    results.total_overdue += inv.amount_due;\n  } else if (daysUntilDue <= 7) {\n    inv.days_until_due = daysUntilDue;\n    results.due_soon.push(inv);\n  } else {\n    inv.days_until_due = daysUntilDue;\n    results.current.push(inv);\n  }\n}\n\n// Sort overdue by days overdue (most overdue first)\nresults.overdue.sort((a, b) => b.days_overdue - a.days_overdue);\n\nreturn [{ json: results }];"
      },
      "id": "categorize-invoices",
      "name": "Categorize by Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 520]
    },
    {
      "parameters": {
        "jsCode": "const payment = $input.first().json;\nconst invoice = payment.invoice;\n\nconst amountPaid = payment.amount_paid;\nconst previouslyPaid = invoice.amount_paid || 0;\nconst totalPaid = previouslyPaid + amountPaid;\nconst amountDue = invoice.total - totalPaid;\n\nreturn [{\n  json: {\n    payment_id: payment.payment_id,\n    invoice_id: invoice.id,\n    invoice_number: invoice.invoice_number,\n    customer: invoice.customer,\n    payment_amount: amountPaid,\n    payment_method: payment.payment_method,\n    payment_date: new Date().toISOString(),\n    invoice_total: invoice.total,\n    total_paid: totalPaid,\n    amount_remaining: amountDue,\n    is_fully_paid: amountDue <= 0,\n    status: amountDue <= 0 ? 'paid' : 'partial'\n  }\n}];"
      },
      "id": "process-payment",
      "name": "Process Payment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 740]
    },
